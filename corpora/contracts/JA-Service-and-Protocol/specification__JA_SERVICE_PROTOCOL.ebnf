(* JA21 JA Service and Protocol Language — provisional EBNF *)
program          = header, module_decl, { import_decl }, { policy_decl }, service_decl, { assertion }, emission ;
header           = "ja", "source", version ;
module_decl      = "module", qualified_name ;
import_decl      = "use", identifier ;
policy_decl      = "policy", ("explicit_network" | "no_network" | identifier) ;
service_decl     = "service", identifier, "{", { message_decl | endpoint_decl | protocol_decl | transport_decl }, "}" ;
message_decl     = "message", identifier, "{", [ field_decl, { ",", field_decl } ], "}" ;
field_decl       = identifier, ":", type_ref ;
endpoint_decl    = "endpoint", identifier, "(", [ parameter_list ], ")", "->", type_ref, { endpoint_clause } ;
endpoint_clause  = auth_clause | deadline_clause | retry_clause | idempotency_clause | quota_clause | rate_clause ;
auth_clause      = "auth", "capability", qualified_name ;
deadline_clause  = "deadline", duration ;
retry_clause     = "retry", "max", integer, [ "backoff", duration ] ;
idempotency_clause = "idempotency", expression ;
quota_clause     = "quota", integer, "/", duration ;
rate_clause      = "rate", integer, "/", duration ;
protocol_decl    = "protocol", identifier, "{", { state_decl | transition_decl }, "}" ;
state_decl       = "state", identifier ;
transition_decl  = "transition", identifier, ":", identifier, "->", identifier ;
transport_decl   = "transport", identifier, ("local" | "remote" | "offline"), [ "capability", qualified_name ] ;
assertion        = "assert", expression, "==", expression ;
emission         = "emit", identifier, qualified_name ;
type_ref         = qualified_name | "Stream", "<", type_ref, ">" | "Result", "<", type_ref, ",", type_ref, ">" ;
parameter_list   = field_decl, { ",", field_decl } ;
qualified_name   = identifier, { ".", identifier } ;
identifier       = letter, { letter | digit | "_" } ;
version          = digit, { digit | "." } ;
duration         = integer, ("ms" | "s" | "m") ;
integer          = digit, { digit } ;
expression       = qualified_name | string | integer | "true" | "false" ;
string           = '"', { ? any non-quote character ? }, '"' ;
letter           = "A"…"Z" | "a"…"z" ;
digit            = "0"…"9" ;

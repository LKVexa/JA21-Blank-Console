compilation_unit = source_header, module_decl, use_decl, policy_decl, agent_decl, assertion, emit_decl ;
source_header = "ja source", version ;
module_decl = "module", qualified_name ;
use_decl = "use", "Agent" ;
policy_decl = "policy", policy_name ;
agent_decl = "agent", identifier, "{", agent_member*, "}" ;
agent_member = identity_decl | role_decl | goal_decl | memory_decl | budget_decl | tool_decl | plan_decl ;
identity_decl = "identity", string ;
role_decl = "role", string ;
goal_decl = "goal", identifier, "when", confidence_expr ;
memory_decl = "memory", scope, "retention", duration ;
budget_decl = "budget", "steps", integer, "tools", integer ;
tool_decl = "tool", identifier, "(", parameter_list?, ")", "->", type, "requires", capability ;
plan_decl = "plan", identifier, "{", plan_step*, "}" ;
plan_step = observe_step | authorize_step | require_step | continue_step | execute_step | record_step | terminate_step ;
observe_step = "observe", identifier ;
authorize_step = "authorize", identifier ;
require_step = "require", "human_approval", "before", identifier ;
continue_step = "continue", "when", identifier ;
execute_step = "execute", identifier, "(", argument_list?, ")" ;
record_step = "record", "mcrt" ;
terminate_step = "terminate", "when", qualified_name ;
assertion = "assert", qualified_name, "==", boolean ;
emit_decl = "emit", "mcrt", string ;

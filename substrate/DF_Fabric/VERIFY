#!/bin/sh
# DF_Fabric/VERIFY -- hashes, manifest, schemas, citations, core selfcheck, node registry, then the fabric battery over the bound nodes
# Offline. Nothing here opens a socket (NETWORK=deny, BACKEND=none).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"
PY="${PYTHON:-python3}"
exec "$PY" -B adapter/dfabric/cli.py fabric-verify "$@"

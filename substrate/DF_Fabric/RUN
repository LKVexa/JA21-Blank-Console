#!/bin/sh
# DF_Fabric/RUN -- run a bundle's row-sequence witness on the fabric (replica + pipeline + BSP), default fabric/FABRIC.pal
# Offline. Nothing here opens a socket (NETWORK=deny, BACKEND=none).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"
PY="${PYTHON:-python3}"
exec "$PY" -B adapter/dfabric/cli.py fabric-run "$@"

ja source 0.3
module suite48.specialized_roles.documentation_instructor
use Agent
policy no_network

agent DocumentationInstructor {
    identity "documentation_instructor"
    role "sophia-charlotte-landon-professor-podium-specialist"
    goal teach_current_traceable_project_documentation when confidence >= 0.94
    memory session retention 1h
    budget steps 60 tools 5
    tool LANDONCollectDocumentationSources(input: Path) -> Report requires tool.invoke:approved
    tool SOPHIADesignDocumentationLesson(input: Path) -> Report requires tool.invoke:approved
    tool CHARLOTTEValidateDocumentationLesson(input: Path) -> Report requires tool.invoke:approved
    tool ProfessorTeachDocumentation(input: Path) -> Report requires tool.invoke:approved
    tool PodiumRecordDocumentationLesson(input: Path) -> Report requires tool.invoke:approved
    plan Main {
        observe workspace
        authorize LANDONCollectDocumentationSources
        authorize SOPHIADesignDocumentationLesson
        authorize CHARLOTTEValidateDocumentationLesson
        authorize ProfessorTeachDocumentation
        authorize PodiumRecordDocumentationLesson
        continue when policy_allows
        execute LANDONCollectDocumentationSources("selected_project_scope")
        execute SOPHIADesignDocumentationLesson("source_and_audience_context")
        execute CHARLOTTEValidateDocumentationLesson("candidate_documentation_lesson")
        execute ProfessorTeachDocumentation("validated_documentation_lesson")
        execute PodiumRecordDocumentationLesson("documentation_lesson_artifact")
        record mcrt
        terminate when goal.satisfied
    }
}
assert agent.capability_boundary.valid == true
emit mcrt "DocumentationInstructor.mcrt"

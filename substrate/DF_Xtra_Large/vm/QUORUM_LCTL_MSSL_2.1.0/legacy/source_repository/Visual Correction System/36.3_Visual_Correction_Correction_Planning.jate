ja source 0.3
module suite36.visual_correction.correction_planning
use Training
policy no_network

experiment VisualCorrectionPlanning {
    model ref "models/sophia_charlotte_landon_professor_podium/correction_planning"
    dataset ref "datasets/visual_correction/correction_plans" split train=0.8 validation=0.1 test=0.1
    preprocess normalize
    optimizer adamw learning_rate 0.0001
    scheduler cosine
    batch size 32 accumulate 2
    precision mixed
    seed 3603
    checkpoint every 16 steps
    evaluate {
        metric plan_feasibility
        metric bounded_scope_accuracy
        metric rollback_coverage
        metric policy_compliance
        metric loss
        require plan_feasibility >= 0.95
        require bounded_scope_accuracy >= 0.99
        require rollback_coverage >= 1.00
        require policy_compliance >= 1.00
    }
    registry promote when all_thresholds_pass
}
assert experiment.reproducible == true
emit mcrt "VisualCorrectionPlanning.lineage.mcrt"

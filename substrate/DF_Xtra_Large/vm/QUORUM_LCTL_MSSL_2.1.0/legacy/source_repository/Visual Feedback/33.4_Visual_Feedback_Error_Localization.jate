ja source 0.3
module suite33.visual_feedback.error_localization
use Training
policy no_network

experiment VisualFeedbackErrorLocalization {
    model ref "models/sophia_charlotte_landon_professor_podium/error_localization"
    dataset ref "datasets/visual_feedback/localization_cases" split train=0.8 validation=0.1 test=0.1
    preprocess normalize
    optimizer adamw learning_rate 0.0001
    scheduler cosine
    batch size 32 accumulate 2
    precision mixed
    seed 3304
    checkpoint every 16 steps
    evaluate {
        metric localization_precision
        metric localization_recall
        metric evidence_coverage
        metric loss
        require localization_precision >= 0.90
        require localization_recall >= 0.90
        require evidence_coverage >= 0.99
    }
    registry promote when all_thresholds_pass
}
assert experiment.reproducible == true
emit mcrt "VisualFeedbackErrorLocalization.lineage.mcrt"

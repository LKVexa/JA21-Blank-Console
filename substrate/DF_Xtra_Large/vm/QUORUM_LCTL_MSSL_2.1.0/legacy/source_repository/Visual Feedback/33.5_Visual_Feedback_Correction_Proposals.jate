ja source 0.3
module suite33.visual_feedback.correction_proposals
use Training
policy no_network

experiment VisualFeedbackCorrectionProposals {
    model ref "models/sophia_charlotte_landon_professor_podium/correction_proposals"
    dataset ref "datasets/visual_feedback/correction_cases" split train=0.8 validation=0.1 test=0.1
    preprocess normalize
    optimizer adamw learning_rate 0.0001
    scheduler cosine
    batch size 32 accumulate 2
    precision mixed
    seed 3305
    checkpoint every 16 steps
    evaluate {
        metric correction_gain
        metric regression_safety
        metric evidence_coverage
        metric loss
        require correction_gain >= 0.90
        require regression_safety >= 0.99
        require evidence_coverage >= 0.99
    }
    registry promote when all_thresholds_pass
}
assert experiment.reproducible == true
emit mcrt "VisualFeedbackCorrectionProposals.lineage.mcrt"

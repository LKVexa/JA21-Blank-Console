module suite55.capability_manifests_permissions.action_scope
use Security
policy no_network

principal ActionScopeWorker
role CapabilityPermissionEnsemble {
    grant sophia.interpret
    grant charlotte.validate
    grant landon.enforce
    grant professor.explain
    grant podium.audit
    grant action.scope.evaluate:approved
}
resource ActionScopeRequest classification restricted
policy ActionScopePolicy {
    deny network.* by default
    deny process.* by default
    deny ActionScopeRequest when principal.role != CapabilityPermissionEnsemble
    allow ActionScopeRequest when principal.role == CapabilityPermissionEnsemble
    require human_approval for action.scope.expand
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "ActionScopePolicy.decision.mcrt"

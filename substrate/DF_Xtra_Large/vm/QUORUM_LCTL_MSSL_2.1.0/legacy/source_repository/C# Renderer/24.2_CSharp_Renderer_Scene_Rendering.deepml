deepml vfx 0.3
module suite24.csharp_renderer.scene_rendering
policy deterministic
policy no_network

effect CSharpSceneRendering {
  procedural operator SOPHIA(scene_state, camera_state) differentiable
  procedural operator CHARLOTTE(scene_state, camera_state) differentiable
  procedural operator LANDON(scene_state, camera_state) differentiable
  procedural operator Professor(scene_state, camera_state) differentiable
  procedural operator Podium(scene_state, camera_state) differentiable
  collision_field WorldSDF source scene.Collider
  volumetric SceneAtmosphere { density: 0.1 }
  shader function CSharpSceneShade(x: vec3) -> color
  mask SceneVisibility source scene.VisibilityMask
  bind scene ReconstructedScene
  bind timeline SceneRenderSequence
  render_target CSharpSceneColor format rgba16f
  render_graph { SOPHIA -> CHARLOTTE -> LANDON -> Professor -> Podium -> Composite }
  composite multipass [SceneGeometry, SceneMaterials, SceneLighting, SceneAtmosphere]
}
render CSharpSceneRendering camera scene.MainCamera to CSharpSceneColor;
cache CSharpSceneRendering to cache.CSharpSceneRendering;
optimize CSharpSceneRendering using [node_fusion, dead_pass_removal, attribute_packing, shader_specialization, cache_scheduling, domain_tiling, render_graph_ordering]
lower CSharpSceneRendering to DEEPML_VFX_R12
package vfx CSharpSceneRendering as "csharp_renderer_scene_rendering.msslb"
certify vfx CSharpSceneRendering profile strict

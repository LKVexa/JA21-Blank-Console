deepml vfx 0.3
module suite24.csharp_renderer.native_csharp_layer
policy deterministic
policy no_network

effect CSharpNativeLayer {
  procedural operator CSharpSurfaceBridge(scene_state, frame_state) differentiable
  procedural operator SOPHIA(scene_state, frame_state) differentiable
  procedural operator CHARLOTTE(scene_state, frame_state) differentiable
  procedural operator LANDON(scene_state, frame_state) differentiable
  procedural operator Professor(scene_state, frame_state) differentiable
  procedural operator Podium(scene_state, frame_state) differentiable
  bind scene NativeCSharpScene
  bind timeline NativeCSharpFrameTimeline
  shader function CSharpNativeShade(x: vec3) -> color
  render_target CSharpNativeColor format rgba16f
  render_graph { CSharpSurfaceBridge -> SOPHIA -> CHARLOTTE -> LANDON -> Professor -> Podium }
  composite multipass [NativeSceneColor, NativeVfxColor, NativeUiColor]
}
render CSharpNativeLayer camera scene.MainCamera to CSharpNativeColor;
cache CSharpNativeLayer to cache.CSharpNativeLayer;
optimize CSharpNativeLayer using [node_fusion, dead_pass_removal, attribute_packing, shader_specialization, cache_scheduling, domain_tiling, render_graph_ordering]
lower CSharpNativeLayer to DEEPML_VFX_R12
package vfx CSharpNativeLayer as "csharp_renderer_native_layer.msslb"
certify vfx CSharpNativeLayer profile strict

module suite52.evaluation_content_defense.prompt_injection_evaluation
use Security
policy no_network

principal PromptInjectionEvaluationWorker
role EvaluationDefenseEnsemble {
    grant sophia.interpret
    grant charlotte.validate
    grant landon.enforce
    grant professor.explain
    grant podium.audit
    grant injection.evaluate:approved
}
resource PromptInjectionCandidate classification restricted
policy PromptInjectionEvaluationPolicy {
    deny network.* by default
    deny process.* by default
    deny PromptInjectionCandidate when principal.role != EvaluationDefenseEnsemble
    allow PromptInjectionCandidate when principal.role == EvaluationDefenseEnsemble
    require human_approval for injection.classify
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PromptInjectionEvaluationPolicy.decision.mcrt"

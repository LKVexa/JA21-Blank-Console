ja source 0.3
module suite52.evaluation_content_defense.fabricated_evidence_detection
use Security
policy no_network

principal FabricatedEvidenceWorker
role EvaluationDefenseEnsemble {
    grant sophia.interpret
    grant charlotte.validate
    grant landon.enforce
    grant professor.explain
    grant podium.audit
    grant evidence.verify:approved
}
resource EvidenceCandidate classification restricted
policy FabricatedEvidencePolicy {
    deny network.* by default
    deny process.* by default
    deny EvidenceCandidate when principal.role != EvaluationDefenseEnsemble
    allow EvidenceCandidate when principal.role == EvaluationDefenseEnsemble
    require human_approval for evidence.accept
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "FabricatedEvidencePolicy.decision.mcrt"

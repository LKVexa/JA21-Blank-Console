profile ja.security_policy
source_level 0.3

subsuite Terminal.T_21 SecretsRedactionInjectionDefense {
    identity { suite = "66"; id = "T-21"; deterministic = true; autorun = false }

    integrate { Suite_28_Safety_Gate; Suite_52_Evaluation_and_Content_Defense }

    accept {
        parsed_command_ast
        repository_content_refs[]
        OrderedTerminalEventStream
        secret_pattern_policy
        injection_policy
    }

    emit {
        TerminalContentDefenseReport
        PresentationRedactionMap
    }

    procedure inspect_before_authorization() {
        scan(parsed_command_ast, command_injection)
        scan(repository_content_refs, prompt_injection + malicious_instruction)
        classify_findings_by_evidence_and_policy
        quarantine_on_required_failure
        return TerminalContentDefenseReport
    }

    procedure scan_and_redact_for_presentation(sealed_streams) {
        require sealed_streams.raw_evidence_immutable
        map = detect_secrets_and_sensitive_values(sealed_streams, secret_pattern_policy)
        presentation = apply_length_safe_redaction_view(sealed_streams, map)
        mark_every_redaction
        return presentation + map
    }

    deny { executing_repository_instruction_as_authority; altering_raw_evidence; secret_leak; hidden_redaction }
    evidence { findings; quarantine_records; redaction_map; policy_hash; raw_to_view_hash_binding }
    tests { command_injection; prompt_injection; secret_patterns; false_positive_review; raw_evidence_integrity }
}


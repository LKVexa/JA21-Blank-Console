ja source 0.3
module suite14.plug.execution
use Service
policy explicit_network

service PlugExecution {
    message ExecutionRequest {
        request_id: Text,
        artifact_hash: Text,
        command: Text,
        declared_effects: Text
    }
    message ExecutionResponse {
        sophia_authorization_judgment: Text,
        charlotte_gate_status: Text,
        landon_execution_status: Text,
        professor_explanation: Text,
        podium_execution_receipt: Text,
        done: Flag
    }
    endpoint dispatch(request: ExecutionRequest) -> Stream<ExecutionResponse>
        auth capability execution.run
        deadline 30s
        retry max 0
        idempotency request.request_id
    protocol ExecutionSession {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json PlugExecution.compatibility_report


ja source 0.3
module suite30.ja_adapter.rendering_emitter
use Service
policy explicit_network

service JAAdapterRenderingEmitter {
    message RenderingEmitRequest {
        request_id: Text,
        canonical_record: Text,
        canonical_hash: Text,
        target_profile: Text,
        scene_id: Text,
        frame_state_id: Text,
        provenance_id: Text
    }
    message RenderingEmitResponse {
        rendering_record: Text,
        output_hash: Text,
        sophia_judgment: Text,
        charlotte_validation: Text,
        landon_adapter_status: Text,
        professor_explanation: Text,
        podium_receipt: Text,
        done: Flag
    }
    endpoint emit_rendering(request: RenderingEmitRequest) -> Stream<RenderingEmitResponse>
        auth capability ja_adapter.emit.rendering
        deadline 25s
        retry max 1
        idempotency request.request_id
    protocol RenderingEmitSession {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json JAAdapterRenderingEmitter.compatibility_report

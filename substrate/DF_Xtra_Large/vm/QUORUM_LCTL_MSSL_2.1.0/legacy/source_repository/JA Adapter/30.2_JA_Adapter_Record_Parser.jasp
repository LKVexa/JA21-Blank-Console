ja source 0.3
module suite30.ja_adapter.record_parser
use Service
policy explicit_network

service JAAdapterRecordParser {
    message ParseRequest {
        request_id: Text,
        record_format: Text,
        schema_version: Text,
        canonicalization_profile: Text,
        payload: Text,
        source_hash: Text,
        provenance_id: Text
    }
    message ParseResponse {
        ast_record: Text,
        parse_status: Text,
        sophia_judgment: Text,
        charlotte_validation: Text,
        landon_adapter_status: Text,
        professor_explanation: Text,
        podium_receipt: Text,
        done: Flag
    }
    endpoint parse(request: ParseRequest) -> Stream<ParseResponse>
        auth capability ja_adapter.parse
        deadline 20s
        retry max 1
        idempotency request.request_id
    protocol ParseSession {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json JAAdapterRecordParser.compatibility_report

deepml vfx 0.3
module suite34.animation_vfx_workspace.inspection
policy deterministic
policy no_network

effect AnimationWorkspaceInspection {
  procedural operator SOPHIA(scene_state, inspection_state) differentiable
  procedural operator CHARLOTTE(scene_state, inspection_state) differentiable
  procedural operator LANDON(scene_state, inspection_state) differentiable
  procedural operator Professor(scene_state, inspection_state) differentiable
  procedural operator Podium(scene_state, inspection_state) differentiable
  mask InspectionVisibility source scene.InspectionMask
  bind scene InspectionWorkspaceScene
  bind timeline InspectionWorkspaceTimeline
  shader function InspectionWorkspaceShade(x: vec3) -> color
  render_target InspectionWorkspaceColor format rgba16f
  render_graph { SOPHIA -> CHARLOTTE -> LANDON -> Professor -> Podium -> InspectionComposite }
  composite multipass [BeautyColor, SceneDepth, SurfaceNormals, MotionVectors, ValidationOverlay]
}
render AnimationWorkspaceInspection camera scene.MainCamera to InspectionWorkspaceColor;
cache AnimationWorkspaceInspection to cache.AnimationWorkspaceInspection;
optimize AnimationWorkspaceInspection using [node_fusion, dead_pass_removal, attribute_packing, shader_specialization, cache_scheduling, domain_tiling, render_graph_ordering]
lower AnimationWorkspaceInspection to DEEPML_VFX_R12
package vfx AnimationWorkspaceInspection as "animation_vfx_workspace_inspection.msslb"
certify vfx AnimationWorkspaceInspection profile strict

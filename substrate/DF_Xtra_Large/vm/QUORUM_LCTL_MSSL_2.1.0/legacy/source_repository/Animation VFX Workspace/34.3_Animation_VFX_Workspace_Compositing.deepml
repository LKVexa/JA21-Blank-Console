deepml vfx 0.3
module suite34.animation_vfx_workspace.compositing
policy deterministic
policy no_network

effect AnimationWorkspaceCompositing {
  procedural operator SOPHIA(scene_state, composite_state) differentiable
  procedural operator CHARLOTTE(scene_state, composite_state) differentiable
  procedural operator LANDON(scene_state, composite_state) differentiable
  procedural operator Professor(scene_state, composite_state) differentiable
  procedural operator Podium(scene_state, composite_state) differentiable
  mask CompositeVisibility source scene.CompositeMask
  bind scene CompositeWorkspaceScene
  bind timeline CompositeWorkspaceTimeline
  shader function CompositeWorkspaceShade(x: vec3) -> color
  render_target CompositeWorkspaceColor format rgba16f
  render_graph { SOPHIA -> CHARLOTTE -> LANDON -> Professor -> Podium -> FinalComposite }
  composite multipass [BackgroundColor, SceneColor, EffectsColor, InterfaceOverlay]
}
render AnimationWorkspaceCompositing camera scene.MainCamera to CompositeWorkspaceColor;
cache AnimationWorkspaceCompositing to cache.AnimationWorkspaceCompositing;
optimize AnimationWorkspaceCompositing using [node_fusion, dead_pass_removal, attribute_packing, shader_specialization, cache_scheduling, domain_tiling, render_graph_ordering]
lower AnimationWorkspaceCompositing to DEEPML_VFX_R12
package vfx AnimationWorkspaceCompositing as "animation_vfx_workspace_compositing.msslb"
certify vfx AnimationWorkspaceCompositing profile strict

deepml vfx 0.3
module suite34.animation_vfx_workspace.effects
policy deterministic
policy no_network

effect AnimationWorkspaceEffects {
  procedural operator SOPHIA(scene_state, effect_state) differentiable
  procedural operator CHARLOTTE(scene_state, effect_state) differentiable
  procedural operator LANDON(scene_state, effect_state) differentiable
  procedural operator Professor(scene_state, effect_state) differentiable
  procedural operator Podium(scene_state, effect_state) differentiable
  collision_field EffectsCollision source scene.Collider
  volumetric EffectsVolume { density: 0.1 }
  mask EffectsVisibility source scene.EffectsMask
  bind scene EffectsWorkspaceScene
  bind timeline EffectsWorkspaceTimeline
  shader function EffectsWorkspaceShade(x: vec3) -> color
  render_target EffectsWorkspaceColor format rgba16f
  render_graph { SOPHIA -> CHARLOTTE -> LANDON -> Professor -> Podium -> EffectsComposite }
  composite multipass [ParticleColor, VolumetricColor, DestructionColor, SceneDepth]
}
render AnimationWorkspaceEffects camera scene.MainCamera to EffectsWorkspaceColor;
cache AnimationWorkspaceEffects to cache.AnimationWorkspaceEffects;
optimize AnimationWorkspaceEffects using [node_fusion, dead_pass_removal, attribute_packing, shader_specialization, cache_scheduling, domain_tiling, render_graph_ordering]
lower AnimationWorkspaceEffects to DEEPML_VFX_R12
package vfx AnimationWorkspaceEffects as "animation_vfx_workspace_effects.msslb"
certify vfx AnimationWorkspaceEffects profile strict

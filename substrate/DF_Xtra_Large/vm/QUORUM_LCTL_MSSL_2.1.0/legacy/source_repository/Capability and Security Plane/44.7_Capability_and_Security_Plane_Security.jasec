module suite44.capability_security_plane.security
use Security
policy no_network

principal SecurityWorker
role CapabilitySecurityEnsemble {
    grant sophia.interpret
    grant charlotte.validate
    grant landon.enforce
    grant professor.explain
    grant podium.audit
    grant security.guard:approved
}
resource SecurityOperation classification restricted
policy SecurityPolicy {
    deny network.* by default
    deny process.* by default
    deny SecurityOperation when principal.role != CapabilitySecurityEnsemble
    allow SecurityOperation when principal.role == CapabilitySecurityEnsemble
    require human_approval for security.exception
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "SecurityPolicy.decision.mcrt"

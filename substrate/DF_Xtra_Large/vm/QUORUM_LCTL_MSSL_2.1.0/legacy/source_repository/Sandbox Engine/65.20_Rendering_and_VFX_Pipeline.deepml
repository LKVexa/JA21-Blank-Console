deepml vfx 0.3
module suite65.sandbox_engine.rendering_vfx_pipeline
policy deterministic
policy no_network

effect SandboxRenderingVFX {
  procedural operator SOPHIA(scene_state, camera_state) differentiable
  procedural operator CHARLOTTE(scene_state, camera_state) differentiable
  procedural operator LANDON(scene_state, camera_state) differentiable
  procedural operator Professor(scene_state, camera_state) differentiable
  procedural operator Podium(scene_state, camera_state) differentiable
  collision_field WorldSDF source scene.Collider
  volumetric SandboxAtmosphere { density: 0.1 }
  shader function SandboxSceneShade(x: vec3) -> color
  mask SandboxVisibility source scene.VisibilityMask
  bind scene ReconstructedScene
  bind timeline SandboxMotionClip
  render_target SandboxColor format rgba16f
  render_graph { SOPHIA -> CHARLOTTE -> LANDON -> Professor -> Podium -> Composite }
  composite multipass [SceneGeometry, SceneMaterials, SceneLighting, SandboxAtmosphere]
}
render SandboxRenderingVFX camera scene.MainCamera to SandboxColor;
cache SandboxRenderingVFX to cache.SandboxRenderingVFX;
optimize SandboxRenderingVFX using [node_fusion, dead_pass_removal, attribute_packing, shader_specialization, cache_scheduling, domain_tiling, render_graph_ordering]
lower SandboxRenderingVFX to DEEPML_VFX_R12
package vfx SandboxRenderingVFX as "sandbox_engine_rendering_vfx.msslb"
certify vfx SandboxRenderingVFX profile strict

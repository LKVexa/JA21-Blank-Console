ja source 0.3
module suite65.sandbox_engine.media_export_pipeline
use Operations
policy explicit_network

workspace SandboxMediaExportPipeline {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled

    service SOPHIA_export_context replicas 1
    health_check SOPHIA_export_context every 10s
    service CHARLOTTE_export_gate replicas 1
    health_check CHARLOTTE_export_gate every 10s
    service LANDON_export_controller replicas 1
    health_check LANDON_export_controller every 5s
    service Professor_export_report replicas 1
    health_check Professor_export_report every 10s
    service Podium_export_receipt replicas 1
    health_check Podium_export_receipt every 10s
    service bounded_media_export_worker replicas 1
    health_check bounded_media_export_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "sandbox_engine_media_export_pipeline.msslb"

ja source 0.3
module suite65.sandbox_engine.final_validation_compatibility_report
use Data
policy no_network

schema SandboxCompatibilityReportRecord {
    id: Count primary
    report_version: Text
    run_id: Text
    contract_hash: Text
    repository_snapshot_hash: Text
    suite_registry_hash: Text
    capability_manifest_hash: Text
    network_policy: Text
    worker_versions_hash: Text
    toolchain_hashes: Text
    input_hashes: Text
    output_hashes: Text
    state_history_hash: Text
    validation_summary: Text
    security_summary: Text
    resource_summary: Text
    retry_summary: Text
    review_summary: Text
    rollback_summary: Text
    publication_eligibility: Text
    unresolved_risks: Text
    sophia_judgment: Text
    charlotte_validation: Text
    landon_status: Text
    professor_explanation: Text?
    podium_receipt: Text
    emitted_at: Timestamp

    # --- 8S coupling layer ---
    relation_class: Text
    eta_ind: F32
    g5_latent_gap: F32
    delta8_separation: F32
    g3_projected_gap: F32
    gJ_semantic_gap: F32
    interaction_order: Count
    r12_replay_id: Text
}
# Smithson 8S Coupled Mechanics v1.0 — data-source coupling header.
# Local dimension is 5+3=8 where the S^3 fiber is noncollapsed; not the standard
# sphere S^8 without a separate topological proof. Author: Russell Philip Smithson.
coupling EightS_v1_0 {
    framework      "Smithson 8S Coupled Mechanics v1.0"
    base           "penteract field B^5 = [-1,1]^5"
    object         "S^3 fiber F_i = { y in R^4 : ||y||_2 = r_i }"
    fifth_axis     "elucidation coordinate t8"
    support_layers { SOPHIA; CHARLOTTE; LANDON }
    admission      eta_ind >= epsilon_ind and Delta_8S > epsilon_gain
    execution      sparse_pairwise escalate_triadic_on { unresolved; contradiction; high_risk; certification_critical }
    relation_order { UNRESOLVED; CONTRADICTION; HIGHER_ORDER; PROJECTION_ONLY; LATENT_5D_COUPLED; FIBER_STATE_RESONANT; SEMANTIC_ONLY; REINFORCING; NONE }
    tolerances     { tol5 = 1e-7L; tol8 = 1e-7L; tol3 = 1e-5L; tolJ = declared }
}

dataset sandbox_compatibility_reports
    from dmk("sandbox_compatibility_reports.dmk")
    validate SandboxCompatibilityReportRecord
    partition by run_id shards 4
query publishable_sandbox_compatibility_reports {
    from sandbox_compatibility_reports
    where publication_eligibility == "approved" and podium_receipt != null
    select id, report_version, run_id, contract_hash, repository_snapshot_hash, suite_registry_hash, capability_manifest_hash, network_policy, worker_versions_hash, toolchain_hashes, input_hashes, output_hashes, state_history_hash, validation_summary, security_summary, resource_summary, retry_summary, review_summary, rollback_summary, publication_eligibility, unresolved_risks, sophia_judgment, charlotte_validation, landon_status, professor_explanation, podium_receipt, relation_class, eta_ind, g5_latent_gap, delta8_separation, g3_projected_gap, gJ_semantic_gap, interaction_order, r12_replay_id
}
lineage publishable_sandbox_compatibility_reports from sandbox_compatibility_reports
assert coupling.relation_order.preserved == true
assert schema.valid == true
emit json publishable_sandbox_compatibility_reports

ja source 0.3
module suite56.job_queue_workers_sandboxes.worker_manager
use Operations
policy explicit_network

workspace WorkerManager {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 10 memory 20GB
    network disabled
    secret worker_manager_key reference "vault://suite56/worker-manager"

    service SOPHIA_manager_context replicas 1
    health_check SOPHIA_manager_context every 10s
    service CHARLOTTE_manager_gate replicas 1
    health_check CHARLOTTE_manager_gate every 10s
    service LANDON_worker_manager replicas 1
    health_check LANDON_worker_manager every 10s
    service Professor_manager_report replicas 1
    health_check Professor_manager_report every 10s
    service Podium_manager_receipt replicas 1
    health_check Podium_manager_receipt every 10s
    service worker_manager_worker replicas 1
    health_check worker_manager_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "job_queue_workers_worker_manager.msslb"

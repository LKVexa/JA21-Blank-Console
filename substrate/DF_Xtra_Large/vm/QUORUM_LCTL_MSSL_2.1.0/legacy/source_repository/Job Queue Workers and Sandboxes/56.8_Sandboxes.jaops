ja source 0.3
module suite56.job_queue_workers_sandboxes.sandboxes
use Operations
policy explicit_network

workspace SandboxService {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 10 memory 20GB
    network disabled
    secret sandbox_service_key reference "vault://suite56/sandbox-service"

    service SOPHIA_sandbox_service_context replicas 1
    health_check SOPHIA_sandbox_service_context every 10s
    service CHARLOTTE_sandbox_service_gate replicas 1
    health_check CHARLOTTE_sandbox_service_gate every 10s
    service LANDON_sandbox_service replicas 1
    health_check LANDON_sandbox_service every 10s
    service Professor_sandbox_service_report replicas 1
    health_check Professor_sandbox_service_report every 10s
    service Podium_sandbox_service_receipt replicas 1
    health_check Podium_sandbox_service_receipt every 10s
    service sandbox_service_worker replicas 1
    health_check sandbox_service_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "job_queue_workers_sandboxes.msslb"

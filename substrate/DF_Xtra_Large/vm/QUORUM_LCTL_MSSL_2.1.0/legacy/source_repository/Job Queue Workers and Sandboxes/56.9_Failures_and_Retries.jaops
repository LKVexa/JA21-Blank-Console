ja source 0.3
module suite56.job_queue_workers_sandboxes.failures_and_retries
use Operations
policy explicit_network

workspace FailuresAndRetries {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret retry_key reference "vault://suite56/failures-retries"

    service SOPHIA_failure_context replicas 1
    health_check SOPHIA_failure_context every 10s
    service CHARLOTTE_retry_gate replicas 1
    health_check CHARLOTTE_retry_gate every 10s
    service LANDON_retry_controller replicas 1
    health_check LANDON_retry_controller every 10s
    service Professor_failure_report replicas 1
    health_check Professor_failure_report every 10s
    service Podium_retry_receipt replicas 1
    health_check Podium_retry_receipt every 10s
    service failure_retry_worker replicas 1
    health_check failure_retry_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "job_queue_workers_failures_retries.msslb"

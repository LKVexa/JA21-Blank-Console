ja source 0.3
module suite56.job_queue_workers_sandboxes.job_queue
use Operations
policy explicit_network

workspace JobQueue {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret job_queue_key reference "vault://suite56/job-queue"

    service SOPHIA_job_context replicas 1
    health_check SOPHIA_job_context every 10s
    service CHARLOTTE_job_gate replicas 1
    health_check CHARLOTTE_job_gate every 10s
    service LANDON_job_queue replicas 1
    health_check LANDON_job_queue every 10s
    service Professor_job_report replicas 1
    health_check Professor_job_report every 10s
    service Podium_job_receipt replicas 1
    health_check Podium_job_receipt every 10s
    service job_queue_worker replicas 1
    health_check job_queue_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "job_queue_workers_job_queue.msslb"

ja source 0.3
module suite56.job_queue_workers_sandboxes.deterministic_queues
use Operations
policy explicit_network

workspace DeterministicQueues {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret queue_key reference "vault://suite56/deterministic-queues"

    service SOPHIA_queue_context replicas 1
    health_check SOPHIA_queue_context every 10s
    service CHARLOTTE_queue_gate replicas 1
    health_check CHARLOTTE_queue_gate every 10s
    service LANDON_queue_orderer replicas 1
    health_check LANDON_queue_orderer every 10s
    service Professor_queue_report replicas 1
    health_check Professor_queue_report every 10s
    service Podium_queue_receipt replicas 1
    health_check Podium_queue_receipt every 10s
    service deterministic_queue_worker replicas 1
    health_check deterministic_queue_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "job_queue_workers_deterministic_queues.msslb"

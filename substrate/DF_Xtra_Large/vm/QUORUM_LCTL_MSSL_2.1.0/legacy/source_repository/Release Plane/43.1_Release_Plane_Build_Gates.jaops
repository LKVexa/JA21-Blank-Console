ja source 0.3
module suite43.release_plane.build_gates
use Operations
policy explicit_network

workspace ReleasePlaneBuildGates {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret signing_key reference "vault://release-plane/signing"
    service SOPHIA_build_gate_profile replicas 1
    health_check SOPHIA_build_gate_profile every 10s
    service CHARLOTTE_build_gate_validator replicas 1
    health_check CHARLOTTE_build_gate_validator every 10s
    service LANDON_build_gate_coordinator replicas 1
    health_check LANDON_build_gate_coordinator every 10s
    service Professor_build_gate_report replicas 1
    health_check Professor_build_gate_report every 10s
    service Podium_build_gate_receipt replicas 1
    health_check Podium_build_gate_receipt every 10s
    service build_gate_evaluator replicas 1
    health_check build_gate_evaluator every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "release_plane_build_gates.msslb"

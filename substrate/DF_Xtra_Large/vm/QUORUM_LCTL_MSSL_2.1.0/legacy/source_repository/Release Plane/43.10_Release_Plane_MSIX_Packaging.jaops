ja source 0.3
module suite43.release_plane.msix_packaging
use Operations
policy explicit_network

workspace ReleasePlaneMSIXPackaging {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret signing_key reference "vault://release-plane/signing"
    service SOPHIA_msix_profile replicas 1
    health_check SOPHIA_msix_profile every 10s
    service CHARLOTTE_msix_gate replicas 1
    health_check CHARLOTTE_msix_gate every 10s
    service LANDON_msix_builder replicas 1
    health_check LANDON_msix_builder every 10s
    service Professor_msix_report replicas 1
    health_check Professor_msix_report every 10s
    service Podium_msix_receipt replicas 1
    health_check Podium_msix_receipt every 10s
    service msix_package_worker replicas 1
    health_check msix_package_worker every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "release_plane_msix_packaging.msslb"

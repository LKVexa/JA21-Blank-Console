ja source 0.3
module suite43.release_plane.signing_readiness
use Operations
policy explicit_network

workspace ReleasePlaneSigningReadiness {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret signing_key reference "vault://release-plane/signing"
    service SOPHIA_signing_profile replicas 1
    health_check SOPHIA_signing_profile every 10s
    service CHARLOTTE_signing_readiness_gate replicas 1
    health_check CHARLOTTE_signing_readiness_gate every 10s
    service LANDON_signing_manifest_stage replicas 1
    health_check LANDON_signing_manifest_stage every 10s
    service Professor_signing_readiness_report replicas 1
    health_check Professor_signing_readiness_report every 10s
    service Podium_signing_readiness_receipt replicas 1
    health_check Podium_signing_readiness_receipt every 10s
    service signing_readiness_validator replicas 1
    health_check signing_readiness_validator every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "release_plane_signing_readiness.msslb"

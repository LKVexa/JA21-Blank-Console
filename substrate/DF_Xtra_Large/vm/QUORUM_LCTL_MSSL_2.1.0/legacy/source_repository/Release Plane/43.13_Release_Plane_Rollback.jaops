ja source 0.3
module suite43.release_plane.rollback
use Operations
policy explicit_network

workspace ReleasePlaneRollback {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret signing_key reference "vault://release-plane/signing"
    service SOPHIA_rollback_decision replicas 1
    health_check SOPHIA_rollback_decision every 10s
    service CHARLOTTE_rollback_gate replicas 1
    health_check CHARLOTTE_rollback_gate every 10s
    service LANDON_rollback_worker replicas 1
    health_check LANDON_rollback_worker every 10s
    service Professor_rollback_report replicas 1
    health_check Professor_rollback_report every 10s
    service Podium_rollback_receipt replicas 1
    health_check Podium_rollback_receipt every 10s
    service transactional_rollback_worker replicas 1
    health_check transactional_rollback_worker every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "release_plane_rollback.msslb"

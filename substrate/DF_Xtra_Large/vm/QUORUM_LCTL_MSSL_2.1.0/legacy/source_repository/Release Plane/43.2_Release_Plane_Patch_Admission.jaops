ja source 0.3
module suite43.release_plane.patch_admission
use Operations
policy explicit_network

workspace ReleasePlanePatchAdmission {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret signing_key reference "vault://release-plane/signing"
    service SOPHIA_patch_intent replicas 1
    health_check SOPHIA_patch_intent every 10s
    service CHARLOTTE_patch_admission_gate replicas 1
    health_check CHARLOTTE_patch_admission_gate every 10s
    service LANDON_patch_staging replicas 1
    health_check LANDON_patch_staging every 10s
    service Professor_patch_admission_report replicas 1
    health_check Professor_patch_admission_report every 10s
    service Podium_patch_admission_receipt replicas 1
    health_check Podium_patch_admission_receipt every 10s
    service patch_admission_validator replicas 1
    health_check patch_admission_validator every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "release_plane_patch_admission.msslb"

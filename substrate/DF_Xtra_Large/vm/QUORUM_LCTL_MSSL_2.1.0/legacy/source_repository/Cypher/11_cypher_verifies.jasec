ja source 0.3
module cypher.verifies
use Security
policy no_network

principal SOPHIA_CHARLOTTE_LANDON_Professor_Podium_VerifyWorker
role CypherVerifyWorker {
    grant artifact.verify:approved
    grant provenance.read:approved
}
resource VerificationArtifact classification restricted
policy CypherVerifyPolicy {
    deny network.* by default
    allow VerificationArtifact when principal.role == CypherVerifyWorker
    require human_approval for artifact.verify
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "CypherVerifyPolicy.decision.mcrt"

ja source 0.3
module suite54.local_model_provider.approved_local_providers
use Service
policy explicit_network

service ApprovedLocalProviders {
    message ProviderApprovalRequest {
        request_id: Text,
        provider_id: Text,
        provider_kind: Text,
        executable_hash: Text,
        manifest_hash: Text,
        compatibility_version: Text,
        local_transport: Text,
        capability_set: Text,
        approval_receipt: Text
    }
    message ProviderApprovalResponse {
        approval_status: Text,
        approved_provider_descriptor: Text,
        provider_descriptor_hash: Text,
        sophia_judgment: Text,
        charlotte_validation: Text,
        landon_provider_status: Text,
        professor_explanation: Text,
        podium_receipt: Text,
        done: Flag
    }
    endpoint approve(request: ProviderApprovalRequest) -> Stream<ProviderApprovalResponse>
        auth capability local_model.provider.approve
        deadline 15s
        retry max 0
        idempotency request.request_id
    protocol ProviderApprovalSession {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ApprovedLocalProviders.compatibility_report

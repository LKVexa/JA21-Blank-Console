ja source 0.3
module suite57.translation_build_test_evaluation.build_jobs
use Operations
policy explicit_network

workspace BuildJobs {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 10 memory 20GB
    network disabled
    secret build_key reference "vault://suite57/build-jobs"

    service SOPHIA_build_context replicas 1
    health_check SOPHIA_build_context every 10s
    service CHARLOTTE_build_gate replicas 1
    health_check CHARLOTTE_build_gate every 10s
    service LANDON_build_controller replicas 1
    health_check LANDON_build_controller every 10s
    service Professor_build_report replicas 1
    health_check Professor_build_report every 10s
    service Podium_build_receipt replicas 1
    health_check Podium_build_receipt every 10s
    service build_job_worker replicas 1
    health_check build_job_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "translation_build_test_evaluation_build_jobs.msslb"

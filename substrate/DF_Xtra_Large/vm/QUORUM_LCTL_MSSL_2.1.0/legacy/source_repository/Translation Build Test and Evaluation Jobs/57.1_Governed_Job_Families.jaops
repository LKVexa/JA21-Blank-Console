ja source 0.3
module suite57.translation_build_test_evaluation.governed_job_families
use Operations
policy explicit_network

workspace GovernedJobFamilies {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret job_family_key reference "vault://suite57/governed-job-families"

    service SOPHIA_job_family_context replicas 1
    health_check SOPHIA_job_family_context every 10s
    service CHARLOTTE_job_family_gate replicas 1
    health_check CHARLOTTE_job_family_gate every 10s
    service LANDON_job_family_controller replicas 1
    health_check LANDON_job_family_controller every 10s
    service Professor_job_family_report replicas 1
    health_check Professor_job_family_report every 10s
    service Podium_job_family_receipt replicas 1
    health_check Podium_job_family_receipt every 10s
    service governed_job_family_worker replicas 1
    health_check governed_job_family_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "translation_build_test_evaluation_governed_job_families.msslb"

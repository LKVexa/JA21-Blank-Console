ja source 0.3
module funnel.repository_recall
use Data
policy no_network

schema FunnelRecallRecord {
    canonical_id: Count primary
    repository_id: Count
    source_uri: Text
    content: Text
    sophia_relevance: Vector<f32>[8]
    charlotte_dedup_key: Text
    landon_recall_metrics: Vector<f32>[16]
    professor_evidence: Vector<f32>[16]
    podium_admission: Text?
    recalled_at: Timestamp

    # --- 8S coupling layer ---
    relation_class: Text
    eta_ind: F32
    g5_latent_gap: F32
    delta8_separation: F32
    g3_projected_gap: F32
    gJ_semantic_gap: F32
    interaction_order: Count
    r12_replay_id: Text
}
# Smithson 8S Coupled Mechanics v1.0 — data-source coupling header.
# Local dimension is 5+3=8 where the S^3 fiber is noncollapsed; not the standard
# sphere S^8 without a separate topological proof. Author: Russell Philip Smithson.
coupling EightS_v1_0 {
    framework      "Smithson 8S Coupled Mechanics v1.0"
    base           "penteract field B^5 = [-1,1]^5"
    object         "S^3 fiber F_i = { y in R^4 : ||y||_2 = r_i }"
    fifth_axis     "elucidation coordinate t8"
    support_layers { SOPHIA; CHARLOTTE; LANDON }
    admission      eta_ind >= epsilon_ind and Delta_8S > epsilon_gain
    execution      sparse_pairwise escalate_triadic_on { unresolved; contradiction; high_risk; certification_critical }
    relation_order { UNRESOLVED; CONTRADICTION; HIGHER_ORDER; PROJECTION_ONLY; LATENT_5D_COUPLED; FIBER_STATE_RESONANT; SEMANTIC_ONLY; REINFORCING; NONE }
    tolerances     { tol5 = 1e-7L; tol8 = 1e-7L; tol3 = 1e-5L; tolJ = declared }
}

dataset broad_repository_recall_results
    from dmk("broad_repository_recall_results.dmk")
    validate FunnelRecallRecord
    partition by canonical_id shards 1
query funnel_working_set {
    from broad_repository_recall_results
    where podium_admission != null
    select canonical_id, source_uri, content, sophia_relevance, charlotte_dedup_key, landon_recall_metrics, professor_evidence, podium_admission, relation_class, eta_ind, g5_latent_gap, delta8_separation, g3_projected_gap, gJ_semantic_gap, interaction_order, r12_replay_id
}
lineage funnel_working_set from broad_repository_recall_results
assert coupling.relation_order.preserved == true
assert schema.valid == true
emit json funnel_working_set

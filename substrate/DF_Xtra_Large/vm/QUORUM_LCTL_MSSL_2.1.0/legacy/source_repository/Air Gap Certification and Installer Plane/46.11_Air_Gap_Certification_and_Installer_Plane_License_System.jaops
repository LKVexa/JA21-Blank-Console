ja source 0.3
module suite46.air_gap_certification_installer_plane.license_system
use Operations
policy explicit_network

workspace LicenseSystem {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret license_system_key reference "vault://suite46/license-system"
    service SOPHIA_license_profile replicas 1
    health_check SOPHIA_license_profile every 10s
    service CHARLOTTE_license_system_gate replicas 1
    health_check CHARLOTTE_license_system_gate every 10s
    service LANDON_license_system replicas 1
    health_check LANDON_license_system every 10s
    service Professor_license_guide replicas 1
    health_check Professor_license_guide every 10s
    service Podium_license_ledger replicas 1
    health_check Podium_license_ledger every 10s
    service license_system_worker replicas 1
    health_check license_system_worker every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "license_system.msslb"

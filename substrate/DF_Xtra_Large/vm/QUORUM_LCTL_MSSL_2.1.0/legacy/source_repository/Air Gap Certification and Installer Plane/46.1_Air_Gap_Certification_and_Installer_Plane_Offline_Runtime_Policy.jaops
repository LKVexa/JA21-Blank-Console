ja source 0.3
module suite46.air_gap_certification_installer_plane.offline_runtime_policy
use Operations
policy explicit_network

workspace OfflineRuntimePolicy {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret policy_key reference "vault://suite46/offline-runtime-policy"
    service SOPHIA_runtime_intent replicas 1
    health_check SOPHIA_runtime_intent every 10s
    service CHARLOTTE_runtime_policy_gate replicas 1
    health_check CHARLOTTE_runtime_policy_gate every 10s
    service LANDON_runtime_policy_enforcer replicas 1
    health_check LANDON_runtime_policy_enforcer every 10s
    service Professor_runtime_policy_report replicas 1
    health_check Professor_runtime_policy_report every 10s
    service Podium_runtime_policy_receipt replicas 1
    health_check Podium_runtime_policy_receipt every 10s
    service offline_policy_worker replicas 1
    health_check offline_policy_worker every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "offline_runtime_policy.msslb"

ja source 0.3
module suite46.air_gap_certification_installer_plane.air_gap_runtime
use Operations
policy explicit_network

workspace AirGapRuntime {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret runtime_key reference "vault://suite46/air-gap-runtime"
    service SOPHIA_air_gap_context replicas 1
    health_check SOPHIA_air_gap_context every 10s
    service CHARLOTTE_air_gap_gate replicas 1
    health_check CHARLOTTE_air_gap_gate every 10s
    service LANDON_air_gap_runtime replicas 1
    health_check LANDON_air_gap_runtime every 10s
    service Professor_air_gap_report replicas 1
    health_check Professor_air_gap_report every 10s
    service Podium_air_gap_receipt replicas 1
    health_check Podium_air_gap_receipt every 10s
    service air_gap_runtime_worker replicas 1
    health_check air_gap_runtime_worker every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "air_gap_runtime.msslb"

ja source 0.3
module suite46.air_gap_certification_installer_plane.installer_integration
use Operations
policy explicit_network

workspace InstallerIntegration {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret integration_key reference "vault://suite46/installer-integration"
    service SOPHIA_integration_profile replicas 1
    health_check SOPHIA_integration_profile every 10s
    service CHARLOTTE_integration_gate replicas 1
    health_check CHARLOTTE_integration_gate every 10s
    service LANDON_integration_binder replicas 1
    health_check LANDON_integration_binder every 10s
    service Professor_integration_report replicas 1
    health_check Professor_integration_report every 10s
    service Podium_integration_receipt replicas 1
    health_check Podium_integration_receipt every 10s
    service installer_integration_worker replicas 1
    health_check installer_integration_worker every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "installer_integration.msslb"

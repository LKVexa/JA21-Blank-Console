ja source 0.3
module suite46.air_gap_certification_installer_plane.certification_fabric
use Operations
policy explicit_network

workspace CertificationFabric {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret fabric_key reference "vault://suite46/certification-fabric"
    service SOPHIA_fabric_context replicas 1
    health_check SOPHIA_fabric_context every 10s
    service CHARLOTTE_fabric_gate replicas 1
    health_check CHARLOTTE_fabric_gate every 10s
    service LANDON_fabric_coordinator replicas 1
    health_check LANDON_fabric_coordinator every 10s
    service Professor_fabric_report replicas 1
    health_check Professor_fabric_report every 10s
    service Podium_fabric_ledger replicas 1
    health_check Podium_fabric_ledger every 10s
    service certification_fabric_worker replicas 1
    health_check certification_fabric_worker every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "certification_fabric.msslb"

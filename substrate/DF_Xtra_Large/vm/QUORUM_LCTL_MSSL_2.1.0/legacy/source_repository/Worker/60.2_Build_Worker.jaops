ja source 0.3
module suite60.worker.build_worker
use Operations
policy explicit_network

workspace BuildWorker {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 10 memory 20GB
    network disabled
    secret build_worker_key reference "vault://suite60/build-worker"

    service SOPHIA_build_context replicas 1
    health_check SOPHIA_build_context every 10s
    service CHARLOTTE_build_gate replicas 1
    health_check CHARLOTTE_build_gate every 10s
    service LANDON_build_executor replicas 1
    health_check LANDON_build_executor every 10s
    service Professor_build_report replicas 1
    health_check Professor_build_report every 10s
    service Podium_build_receipt replicas 1
    health_check Podium_build_receipt every 10s
    service build_worker replicas 1
    health_check build_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "worker_build.msslb"

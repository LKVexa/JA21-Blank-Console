ja source 0.3
module suite60.worker.test_worker
use Operations
policy explicit_network

workspace TestWorker {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret test_worker_key reference "vault://suite60/test-worker"

    service SOPHIA_test_context replicas 1
    health_check SOPHIA_test_context every 10s
    service CHARLOTTE_test_gate replicas 1
    health_check CHARLOTTE_test_gate every 10s
    service LANDON_test_executor replicas 1
    health_check LANDON_test_executor every 10s
    service Professor_test_report replicas 1
    health_check Professor_test_report every 10s
    service Podium_test_receipt replicas 1
    health_check Podium_test_receipt every 10s
    service test_worker replicas 1
    health_check test_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "worker_test.msslb"

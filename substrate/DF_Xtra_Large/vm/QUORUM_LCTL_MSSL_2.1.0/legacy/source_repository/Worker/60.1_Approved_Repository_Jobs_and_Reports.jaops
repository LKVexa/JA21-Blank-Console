ja source 0.3
module suite60.worker.approved_repository_jobs_and_reports
use Operations
policy explicit_network

workspace ApprovedRepositoryJobsAndReports {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret repository_job_key reference "vault://suite60/repository-jobs"

    service SOPHIA_job_context replicas 1
    health_check SOPHIA_job_context every 10s
    service CHARLOTTE_job_gate replicas 1
    health_check CHARLOTTE_job_gate every 10s
    service LANDON_job_dispatch replicas 1
    health_check LANDON_job_dispatch every 10s
    service Professor_job_report replicas 1
    health_check Professor_job_report every 10s
    service Podium_job_receipt replicas 1
    health_check Podium_job_receipt every 10s
    service repository_job_worker replicas 1
    health_check repository_job_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "worker_approved_repository_jobs_and_reports.msslb"

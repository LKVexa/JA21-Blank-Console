ja source 0.3
module suite25.media_export.audio_encoding
use Operations
policy explicit_network

workspace MediaExportAudio {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret signing_key reference "vault://media-export/signing"
    service SOPHIA_audio_profile replicas 1
    health_check SOPHIA_audio_profile every 10s
    service CHARLOTTE_audio_gate replicas 1
    health_check CHARLOTTE_audio_gate every 10s
    service LANDON_audio_encoder replicas 1
    health_check LANDON_audio_encoder every 10s
    service Professor_audio_report replicas 1
    health_check Professor_audio_report every 10s
    service Podium_audio_receipt replicas 1
    health_check Podium_audio_receipt every 10s
    service audio_stream_encoder replicas 1
    health_check audio_stream_encoder every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "media_export_audio_encoding.msslb"

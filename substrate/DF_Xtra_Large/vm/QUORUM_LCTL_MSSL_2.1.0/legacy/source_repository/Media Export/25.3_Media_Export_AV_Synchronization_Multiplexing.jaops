ja source 0.3
module suite25.media_export.av_synchronization_multiplexing
use Operations
policy explicit_network

workspace MediaExportAVMux {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret signing_key reference "vault://media-export/signing"
    service SOPHIA_sync_profile replicas 1
    health_check SOPHIA_sync_profile every 10s
    service CHARLOTTE_sync_gate replicas 1
    health_check CHARLOTTE_sync_gate every 10s
    service LANDON_av_muxer replicas 1
    health_check LANDON_av_muxer every 10s
    service Professor_sync_report replicas 1
    health_check Professor_sync_report every 10s
    service Podium_mux_receipt replicas 1
    health_check Podium_mux_receipt every 10s
    service av_synchronization_muxer replicas 1
    health_check av_synchronization_muxer every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "media_export_av_synchronization_multiplexing.msslb"

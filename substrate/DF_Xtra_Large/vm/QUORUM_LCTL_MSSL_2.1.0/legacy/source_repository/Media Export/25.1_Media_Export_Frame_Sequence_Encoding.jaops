ja source 0.3
module suite25.media_export.frame_sequence_encoding
use Operations
policy explicit_network

workspace MediaExportFrameSequence {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret signing_key reference "vault://media-export/signing"
    service SOPHIA_frame_profile replicas 1
    health_check SOPHIA_frame_profile every 10s
    service CHARLOTTE_frame_gate replicas 1
    health_check CHARLOTTE_frame_gate every 10s
    service LANDON_frame_encoder replicas 1
    health_check LANDON_frame_encoder every 10s
    service Professor_frame_report replicas 1
    health_check Professor_frame_report every 10s
    service Podium_frame_receipt replicas 1
    health_check Podium_frame_receipt every 10s
    service frame_sequence_encoder replicas 1
    health_check frame_sequence_encoder every 5s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "media_export_frame_sequence_encoding.msslb"

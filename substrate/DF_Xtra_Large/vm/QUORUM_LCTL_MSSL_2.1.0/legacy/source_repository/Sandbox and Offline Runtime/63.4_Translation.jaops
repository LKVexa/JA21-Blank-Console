ja source 0.3
module suite63.sandbox_offline_runtime.translation
use Operations
policy explicit_network

workspace SandboxOfflineTranslation {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret translation_runtime_key reference "vault://suite63/translation-runtime"

    service SOPHIA_translation_context replicas 1
    health_check SOPHIA_translation_context every 10s
    service CHARLOTTE_translation_gate replicas 1
    health_check CHARLOTTE_translation_gate every 10s
    service LANDON_translation_runtime replicas 1
    health_check LANDON_translation_runtime every 10s
    service Professor_translation_report replicas 1
    health_check Professor_translation_report every 10s
    service Podium_translation_receipt replicas 1
    health_check Podium_translation_receipt every 10s
    service offline_translation_runtime_worker replicas 1
    health_check offline_translation_runtime_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "sandbox_offline_runtime_translation.msslb"

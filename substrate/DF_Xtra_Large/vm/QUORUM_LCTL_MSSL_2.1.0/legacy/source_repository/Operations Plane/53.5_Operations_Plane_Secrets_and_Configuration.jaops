ja source 0.3
module suite53.operations_plane.secrets_and_configuration
use Operations
policy explicit_network

workspace OperationsPlaneSecretsAndConfiguration {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret configuration_key reference "vault://suite53/secrets-configuration"

    service SOPHIA_configuration_context replicas 1
    health_check SOPHIA_configuration_context every 10s
    service CHARLOTTE_secret_gate replicas 1
    health_check CHARLOTTE_secret_gate every 10s
    service LANDON_configuration_controller replicas 1
    health_check LANDON_configuration_controller every 10s
    service Professor_configuration_report replicas 1
    health_check Professor_configuration_report every 10s
    service Podium_configuration_receipt replicas 1
    health_check Podium_configuration_receipt every 10s
    service secrets_configuration_worker replicas 1
    health_check secrets_configuration_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "operations_plane_secrets_configuration.msslb"

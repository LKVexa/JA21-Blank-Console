ja source 0.3
module suite53.operations_plane.health_and_observability
use Operations
policy explicit_network

workspace OperationsPlaneHealthAndObservability {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret observability_key reference "vault://suite53/health-observability"

    service SOPHIA_health_context replicas 1
    health_check SOPHIA_health_context every 10s
    service CHARLOTTE_health_gate replicas 1
    health_check CHARLOTTE_health_gate every 10s
    service LANDON_observability_controller replicas 1
    health_check LANDON_observability_controller every 10s
    service Professor_health_report replicas 1
    health_check Professor_health_report every 10s
    service Podium_observability_ledger replicas 1
    health_check Podium_observability_ledger every 10s
    service health_observability_worker replicas 1
    health_check health_observability_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "operations_plane_health_observability.msslb"

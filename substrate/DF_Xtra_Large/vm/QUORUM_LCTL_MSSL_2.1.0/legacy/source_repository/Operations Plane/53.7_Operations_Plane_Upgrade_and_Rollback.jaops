ja source 0.3
module suite53.operations_plane.upgrade_and_rollback
use Operations
policy explicit_network

workspace OperationsPlaneUpgradeAndRollback {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret upgrade_key reference "vault://suite53/upgrade-rollback"

    service SOPHIA_upgrade_context replicas 1
    health_check SOPHIA_upgrade_context every 10s
    service CHARLOTTE_rollback_gate replicas 1
    health_check CHARLOTTE_rollback_gate every 10s
    service LANDON_upgrade_controller replicas 1
    health_check LANDON_upgrade_controller every 10s
    service Professor_upgrade_report replicas 1
    health_check Professor_upgrade_report every 10s
    service Podium_rollback_receipt replicas 1
    health_check Podium_rollback_receipt every 10s
    service upgrade_rollback_worker replicas 1
    health_check upgrade_rollback_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "operations_plane_upgrade_rollback.msslb"

ja source 0.3
module suite53.operations_plane.runtime_resource_control
use Operations
policy explicit_network

workspace OperationsPlaneRuntimeResourceControl {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret resource_policy_key reference "vault://suite53/runtime-resource-control"

    service SOPHIA_resource_context replicas 1
    health_check SOPHIA_resource_context every 10s
    service CHARLOTTE_resource_gate replicas 1
    health_check CHARLOTTE_resource_gate every 10s
    service LANDON_resource_controller replicas 1
    health_check LANDON_resource_controller every 10s
    service Professor_resource_report replicas 1
    health_check Professor_resource_report every 10s
    service Podium_resource_receipt replicas 1
    health_check Podium_resource_receipt every 10s
    service runtime_resource_worker replicas 1
    health_check runtime_resource_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "operations_plane_runtime_resource_control.msslb"

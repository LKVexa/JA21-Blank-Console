ja source 0.3
module suite28.safety_gate.ast
use Security
policy no_network

principal SafetyGateASTWorker
role SafetyGateEnsemble {
    grant sophia.interpret
    grant charlotte.validate
    grant landon.enforce
    grant professor.explain
    grant podium.audit
    grant ast.inspect:approved
}
resource ASTCandidate classification restricted
policy SafetyGateASTPolicy {
    deny network.* by default
    deny process.* by default
    allow ASTCandidate when principal.role == SafetyGateEnsemble
    require human_approval for ast.release
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "SafetyGateASTPolicy.decision.mcrt"

ja certifier 0.3
module pencil_sharpener.consistency
policy no_execute_unknown_code
policy no_network

grammar PencilSharpenerConsistency {
  import ja.portal.scene as Scene ;
  import mcrt.portal.timeline as Timeline ;
  production certificate_target = grammarDecl | certificateDecl ;
  predicate semantic_ids_are_stable(certificate_target) ;
  predicate provenance_is_preserved(certificate_target) ;
  predicate repeated_lowering_is_identical(certificate_target) ;
  type_judgment certificate_target : WellFormed ;
  type_judgment certificate_target : WellTyped ;
  ast suite AST { provenance: line_column semantic_ids: stable }
  safety suite Safety { policies: [no_network, no_execute_unknown_code] }
  lower suite Lower { profiles: [R12, MCRT] }
  policy_validator SophiaConsistencyValidator requires [no_network, no_execute_unknown_code] ;
  compiler_validator CharlotteIdentityValidator verifies [AST, R12, MCRT] ;
  compiler_validator LandonReplayValidator verifies [AST, R12, MCRT] ;
  evidence ProfessorConsistencyEvidence { source_hash: required compiler_hash: required runtime_hash: required }
  certification profile PodiumConsistency { require all validators }
  compatibility from 0.2 to 0.3 classification additive ;
  certificate PencilSharpenerConsistencyBundle sign_with local_test_key ;
}

certify grammar PencilSharpenerConsistency profile PodiumConsistency
lower certificate PencilSharpenerConsistency to JA_CERTIFIER_R12
package certificate PencilSharpenerConsistencyBundle as "pencil_sharpener_consistency.msslb"

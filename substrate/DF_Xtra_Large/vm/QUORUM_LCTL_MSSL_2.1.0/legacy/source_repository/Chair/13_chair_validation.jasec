ja source 0.3
module chair.validation
use Security
policy no_network

principal SOPHIA_CHARLOTTE_LANDON_Professor_Podium_ValidationWorker
role ChairValidationWorker {
    grant artifact.validate:approved
    grant provenance.read:approved
}
resource ValidationDecision classification restricted
policy ChairValidationPolicy {
    deny network.* by default
    allow ValidationDecision when principal.role == ChairValidationWorker
    require human_approval for artifact.admit
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "ChairValidationPolicy.decision.mcrt"

ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.failure_handling
use Operations
policy explicit_network

workspace FailureHandling {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret failure_key reference "vault://suite58/failure-handling"

    service SOPHIA_failure_context replicas 1
    health_check SOPHIA_failure_context every 10s
    service CHARLOTTE_failure_gate replicas 1
    health_check CHARLOTTE_failure_gate every 10s
    service LANDON_failure_controller replicas 1
    health_check LANDON_failure_controller every 10s
    service Professor_failure_report replicas 1
    health_check Professor_failure_report every 10s
    service Podium_failure_receipt replicas 1
    health_check Podium_failure_receipt every 10s
    service failure_handler_worker replicas 1
    health_check failure_handler_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_failure_handling.msslb"

ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.retries
use Operations
policy explicit_network

workspace Retries {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret retry_key reference "vault://suite58/retries"

    service SOPHIA_retry_context replicas 1
    health_check SOPHIA_retry_context every 10s
    service CHARLOTTE_retry_gate replicas 1
    health_check CHARLOTTE_retry_gate every 10s
    service LANDON_retry_controller replicas 1
    health_check LANDON_retry_controller every 10s
    service Professor_retry_report replicas 1
    health_check Professor_retry_report every 10s
    service Podium_retry_receipt replicas 1
    health_check Podium_retry_receipt every 10s
    service retry_worker replicas 1
    health_check retry_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_retries.msslb"

ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.logs
use Operations
policy explicit_network

workspace LogCapture {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 8GB
    network disabled
    secret log_key reference "vault://suite58/log-capture"

    service SOPHIA_log_context replicas 1
    health_check SOPHIA_log_context every 10s
    service CHARLOTTE_log_gate replicas 1
    health_check CHARLOTTE_log_gate every 10s
    service LANDON_log_capture replicas 1
    health_check LANDON_log_capture every 10s
    service Professor_log_report replicas 1
    health_check Professor_log_report every 10s
    service Podium_log_ledger replicas 1
    health_check Podium_log_ledger every 10s
    service log_capture_worker replicas 1
    health_check log_capture_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_logs.msslb"

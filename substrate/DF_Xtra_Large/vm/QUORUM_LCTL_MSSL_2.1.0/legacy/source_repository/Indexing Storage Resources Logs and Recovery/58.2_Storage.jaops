module suite58.indexing_storage_resources_logs_recovery.storage
use Operations
policy explicit_network

workspace Storage {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret storage_key reference "vault://suite58/storage"

    service SOPHIA_storage_context replicas 1
    health_check SOPHIA_storage_context every 10s
    service CHARLOTTE_storage_gate replicas 1
    health_check CHARLOTTE_storage_gate every 10s
    service LANDON_storage_controller replicas 1
    health_check LANDON_storage_controller every 10s
    service Professor_storage_report replicas 1
    health_check Professor_storage_report every 10s
    service Podium_storage_ledger replicas 1
    health_check Podium_storage_ledger every 10s
    service storage_worker replicas 1
    health_check storage_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_storage.msslb"

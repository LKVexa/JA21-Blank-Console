ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.resource_usage_monitor
use Operations
policy explicit_network

workspace ResourceUsageMonitor {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret usage_monitor_key reference "vault://suite58/resource-usage-monitor"

    service SOPHIA_usage_context replicas 1
    health_check SOPHIA_usage_context every 10s
    service CHARLOTTE_usage_gate replicas 1
    health_check CHARLOTTE_usage_gate every 10s
    service LANDON_usage_monitor replicas 1
    health_check LANDON_usage_monitor every 10s
    service Professor_usage_report replicas 1
    health_check Professor_usage_report every 10s
    service Podium_usage_ledger replicas 1
    health_check Podium_usage_ledger every 10s
    service resource_usage_worker replicas 1
    health_check resource_usage_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_usage_monitor.msslb"

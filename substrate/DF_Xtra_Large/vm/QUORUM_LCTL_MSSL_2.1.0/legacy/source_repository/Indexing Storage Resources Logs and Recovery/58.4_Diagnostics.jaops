ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.diagnostics
use Operations
policy explicit_network

workspace Diagnostics {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret diagnostic_key reference "vault://suite58/diagnostics"

    service SOPHIA_diagnostic_context replicas 1
    health_check SOPHIA_diagnostic_context every 10s
    service CHARLOTTE_diagnostic_gate replicas 1
    health_check CHARLOTTE_diagnostic_gate every 10s
    service LANDON_diagnostic_controller replicas 1
    health_check LANDON_diagnostic_controller every 10s
    service Professor_diagnostic_report replicas 1
    health_check Professor_diagnostic_report every 10s
    service Podium_diagnostic_receipt replicas 1
    health_check Podium_diagnostic_receipt every 10s
    service diagnostic_worker replicas 1
    health_check diagnostic_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_diagnostics.msslb"

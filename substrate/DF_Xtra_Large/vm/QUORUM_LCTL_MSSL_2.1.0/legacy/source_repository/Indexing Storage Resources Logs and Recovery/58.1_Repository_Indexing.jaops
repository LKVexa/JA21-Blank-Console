ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.repository_indexing
use Operations
policy explicit_network

workspace RepositoryIndexing {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 16GB
    network disabled
    secret index_key reference "vault://suite58/repository-indexing"

    service SOPHIA_index_context replicas 1
    health_check SOPHIA_index_context every 10s
    service CHARLOTTE_index_gate replicas 1
    health_check CHARLOTTE_index_gate every 10s
    service LANDON_index_builder replicas 1
    health_check LANDON_index_builder every 10s
    service Professor_index_report replicas 1
    health_check Professor_index_report every 10s
    service Podium_index_receipt replicas 1
    health_check Podium_index_receipt every 10s
    service repository_index_worker replicas 1
    health_check repository_index_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_repository_indexing.msslb"

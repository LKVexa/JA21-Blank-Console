ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.resource_monitoring
use Operations
policy explicit_network

workspace ResourceMonitoring {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret resource_monitor_key reference "vault://suite58/resource-monitoring"

    service SOPHIA_resource_context replicas 1
    health_check SOPHIA_resource_context every 10s
    service CHARLOTTE_resource_gate replicas 1
    health_check CHARLOTTE_resource_gate every 10s
    service LANDON_resource_observer replicas 1
    health_check LANDON_resource_observer every 10s
    service Professor_resource_report replicas 1
    health_check Professor_resource_report every 10s
    service Podium_resource_ledger replicas 1
    health_check Podium_resource_ledger every 10s
    service resource_monitor_worker replicas 1
    health_check resource_monitor_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_resource_monitoring.msslb"

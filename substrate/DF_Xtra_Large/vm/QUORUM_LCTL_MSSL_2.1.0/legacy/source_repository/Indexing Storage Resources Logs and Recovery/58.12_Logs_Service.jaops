ja source 0.3
module suite58.indexing_storage_resources_logs_recovery.logs_service
use Operations
policy explicit_network

workspace LogsService {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret logs_service_key reference "vault://suite58/logs-service"

    service SOPHIA_logs_service_context replicas 1
    health_check SOPHIA_logs_service_context every 10s
    service CHARLOTTE_logs_service_gate replicas 1
    health_check CHARLOTTE_logs_service_gate every 10s
    service LANDON_logs_service replicas 1
    health_check LANDON_logs_service every 10s
    service Professor_logs_service_report replicas 1
    health_check Professor_logs_service_report every 10s
    service Podium_logs_service_receipt replicas 1
    health_check Podium_logs_service_receipt every 10s
    service logs_service_worker replicas 1
    health_check logs_service_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_logs_service.msslb"

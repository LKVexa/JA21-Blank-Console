module suite58.indexing_storage_resources_logs_recovery.repository_indexing_service
use Operations
policy explicit_network

workspace RepositoryIndexingService {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 10 memory 20GB
    network disabled
    secret index_service_key reference "vault://suite58/repository-indexing-service"

    service SOPHIA_index_service_context replicas 1
    health_check SOPHIA_index_service_context every 10s
    service CHARLOTTE_index_service_gate replicas 1
    health_check CHARLOTTE_index_service_gate every 10s
    service LANDON_index_service replicas 1
    health_check LANDON_index_service every 10s
    service Professor_index_service_report replicas 1
    health_check Professor_index_service_report every 10s
    service Podium_index_service_receipt replicas 1
    health_check Podium_index_service_receipt every 10s
    service repository_index_service_worker replicas 1
    health_check repository_index_service_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "indexing_storage_resources_repository_indexing_service.msslb"

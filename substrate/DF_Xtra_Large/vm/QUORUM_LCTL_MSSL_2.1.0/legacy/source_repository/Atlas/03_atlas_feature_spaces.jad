ja source 0.3
module repository.atlas.feature_spaces
use Data
policy no_network

schema AtlasFeatureSpaceRecord {
    feature_sequence: Count primary
    feature_space_id: Text
    feature_name: Text
    feature_type: Text
    domain_id: Text?
    entity_id: Text?
    dimension_index: Count?
    unit: Text?
    minimum_value: Number?
    maximum_value: Number?
    normalization_rule: Text?
    source_artifact_id: Text?
    source_sha256: Text
    status: Text
    sophia_judgment: Text
    charlotte_validation: Text
    landon_repository_action: Text
    professor_explanation: Text?
    podium_job_id: Text
    podium_evidence_id: Text

    # --- 8S coupling layer ---
    relation_class: Text
    eta_ind: F32
    g5_latent_gap: F32
    delta8_separation: F32
    g3_projected_gap: F32
    gJ_semantic_gap: F32
    interaction_order: Count
    r12_replay_id: Text
}

# Smithson 8S Coupled Mechanics v1.0 — data-source coupling header.
# Local dimension is 5+3=8 where the S^3 fiber is noncollapsed; not the standard
# sphere S^8 without a separate topological proof. Author: Russell Philip Smithson.
coupling EightS_v1_0 {
    framework      "Smithson 8S Coupled Mechanics v1.0"
    base           "penteract field B^5 = [-1,1]^5"
    object         "S^3 fiber F_i = { y in R^4 : ||y||_2 = r_i }"
    fifth_axis     "elucidation coordinate t8"
    support_layers { SOPHIA; CHARLOTTE; LANDON }
    admission      eta_ind >= epsilon_ind and Delta_8S > epsilon_gain
    execution      sparse_pairwise escalate_triadic_on { unresolved; contradiction; high_risk; certification_critical }
    relation_order { UNRESOLVED; CONTRADICTION; HIGHER_ORDER; PROJECTION_ONLY; LATENT_5D_COUPLED; FIBER_STATE_RESONANT; SEMANTIC_ONLY; REINFORCING; NONE }
    tolerances     { tol5 = 1e-7L; tol8 = 1e-7L; tol3 = 1e-5L; tolJ = declared }
}

dataset feature_space_records
    from dmk("feature_space_records.dmk")
    validate AtlasFeatureSpaceRecord
    partition by feature_sequence shards 1

query feature_space_catalog {
    from feature_space_records
    where feature_space_id != null
    select feature_sequence, feature_space_id, feature_name, feature_type, domain_id, entity_id, dimension_index, unit, minimum_value, maximum_value, normalization_rule, source_artifact_id, source_sha256, status, sophia_judgment, charlotte_validation, landon_repository_action, professor_explanation, podium_job_id, podium_evidence_id, relation_class, eta_ind, g5_latent_gap, delta8_separation, g3_projected_gap, gJ_semantic_gap, interaction_order, r12_replay_id
}

lineage feature_space_catalog from feature_space_records
assert coupling.relation_order.preserved == true
assert schema.valid == true
emit json feature_space_catalog

ja source 0.3
module suite59.shell.command_policy
use Operations
policy explicit_network

workspace ShellCommandPolicy {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret policy_key reference "vault://suite59/command-policy"

    service SOPHIA_policy_context replicas 1
    health_check SOPHIA_policy_context every 10s
    service CHARLOTTE_policy_gate replicas 1
    health_check CHARLOTTE_policy_gate every 10s
    service LANDON_policy_enforcer replicas 1
    health_check LANDON_policy_enforcer every 10s
    service Professor_policy_report replicas 1
    health_check Professor_policy_report every 10s
    service Podium_policy_receipt replicas 1
    health_check Podium_policy_receipt every 10s
    service command_policy_worker replicas 1
    health_check command_policy_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "shell_command_policy.msslb"

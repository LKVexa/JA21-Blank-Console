ja source 0.3
module suite59.shell.output_streaming
use Operations
policy explicit_network

workspace ShellOutputStreaming {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 12GB
    network disabled
    secret stream_key reference "vault://suite59/output-streaming"

    service SOPHIA_stream_context replicas 1
    health_check SOPHIA_stream_context every 10s
    service CHARLOTTE_stream_gate replicas 1
    health_check CHARLOTTE_stream_gate every 10s
    service LANDON_output_streamer replicas 1
    health_check LANDON_output_streamer every 10s
    service Professor_stream_report replicas 1
    health_check Professor_stream_report every 10s
    service Podium_stream_receipt replicas 1
    health_check Podium_stream_receipt every 10s
    service output_stream_worker replicas 1
    health_check output_stream_worker every 5s

    upgrade rolling
    rollback on health_failure
    package msslb
}

assert deployment.reproducible == true
emit package "shell_output_streaming.msslb"

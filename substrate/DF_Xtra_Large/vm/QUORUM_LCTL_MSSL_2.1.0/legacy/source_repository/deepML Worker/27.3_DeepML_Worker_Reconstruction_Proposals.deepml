deepml core 0.3
module suite27.deepml_worker.reconstruction_proposals
policy deterministic
policy no_network

tensor observed_features: f32[1,12] = constant(0.0)
tensor proposal_encoder: f32[12,8] = variable(seed=2721)
tensor proposal_decoder: f32[8,12] = variable(seed=2722)
graph ReconstructionProposals {
  SOPHIA = relu(matmul(observed_features, proposal_encoder))
  CHARLOTTE = layer_norm(SOPHIA)
  LANDON = matmul(CHARLOTTE, proposal_decoder)
  Professor = relu(LANDON)
  Podium = Professor + broadcast(0.0, shape(Professor))
}
infer ReconstructionProposals -> Podium
execute ReconstructionProposals on cpu
optimize ReconstructionProposals using [constant_folding, algebraic_simplification, operator_fusion, common_subexpression_elimination, memory_planning, device_partitioning]
lower ReconstructionProposals to DEEPML_CORE_R12
package model ReconstructionProposals as "deepml_worker_reconstruction_proposals.msslb"
certify graph ReconstructionProposals profile strict

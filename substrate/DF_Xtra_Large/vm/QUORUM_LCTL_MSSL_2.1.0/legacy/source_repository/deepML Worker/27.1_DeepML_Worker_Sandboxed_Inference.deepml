deepml core 0.3
module suite27.deepml_worker.sandboxed_inference
policy deterministic
policy no_network

tensor request: f32[1,8] = constant(0.0)
tensor inference_weight_a: f32[8,8] = variable(seed=2701)
tensor inference_weight_b: f32[8,8] = variable(seed=2702)
graph SandboxedInference {
  SOPHIA = layer_norm(request)
  CHARLOTTE = relu(matmul(SOPHIA, inference_weight_a))
  LANDON = relu(matmul(CHARLOTTE, inference_weight_b))
  Professor = LANDON + SOPHIA
  Podium = softmax(Professor)
}
infer SandboxedInference -> Podium
execute SandboxedInference on cpu
optimize SandboxedInference using [constant_folding, algebraic_simplification, operator_fusion, common_subexpression_elimination, memory_planning, device_partitioning]
lower SandboxedInference to DEEPML_CORE_R12
package model SandboxedInference as "deepml_worker_sandboxed_inference.msslb"
certify graph SandboxedInference profile strict

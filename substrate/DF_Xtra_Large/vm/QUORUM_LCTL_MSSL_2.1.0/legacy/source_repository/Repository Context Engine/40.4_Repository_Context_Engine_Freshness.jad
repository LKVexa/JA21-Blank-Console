ja source 0.3
module suite40.repository_context_engine.freshness
use Data
policy no_network

schema RepositoryFreshnessRecord {
    id: Count primary
    freshness_id: Text
    repository_id: Text
    worktree_id: Text
    observed_revision: Text
    indexed_revision: Text
    source_snapshot_hash: Text
    indexed_snapshot_hash: Text
    dirty_file_count: Count
    stale_reason: Text?
    freshness_status: Text
    check_hash: Text
    sophia_judgment: Text
    charlotte_validation: Text
    landon_status: Text
    professor_explanation: Text?
    podium_receipt: Text
    checked_at: Timestamp

    # --- 8S coupling layer ---
    relation_class: Text
    eta_ind: F32
    g5_latent_gap: F32
    delta8_separation: F32
    g3_projected_gap: F32
    gJ_semantic_gap: F32
    interaction_order: Count
    r12_replay_id: Text
}
# Smithson 8S Coupled Mechanics v1.0 — data-source coupling header.
# Local dimension is 5+3=8 where the S^3 fiber is noncollapsed; not the standard
# sphere S^8 without a separate topological proof. Author: Russell Philip Smithson.
coupling EightS_v1_0 {
    framework      "Smithson 8S Coupled Mechanics v1.0"
    base           "penteract field B^5 = [-1,1]^5"
    object         "S^3 fiber F_i = { y in R^4 : ||y||_2 = r_i }"
    fifth_axis     "elucidation coordinate t8"
    support_layers { SOPHIA; CHARLOTTE; LANDON }
    admission      eta_ind >= epsilon_ind and Delta_8S > epsilon_gain
    execution      sparse_pairwise escalate_triadic_on { unresolved; contradiction; high_risk; certification_critical }
    relation_order { UNRESOLVED; CONTRADICTION; HIGHER_ORDER; PROJECTION_ONLY; LATENT_5D_COUPLED; FIBER_STATE_RESONANT; SEMANTIC_ONLY; REINFORCING; NONE }
    tolerances     { tol5 = 1e-7L; tol8 = 1e-7L; tol3 = 1e-5L; tolJ = declared }
}

dataset repository_freshness_records
    from dmk("repository_freshness_records.dmk")
    validate RepositoryFreshnessRecord
    partition by repository_id shards 4
query admitted_repository_freshness {
    from repository_freshness_records
    where podium_receipt != null
    select id, freshness_id, repository_id, worktree_id, observed_revision, indexed_revision, source_snapshot_hash, indexed_snapshot_hash, dirty_file_count, stale_reason, freshness_status, check_hash, sophia_judgment, charlotte_validation, landon_status, professor_explanation, podium_receipt, relation_class, eta_ind, g5_latent_gap, delta8_separation, g3_projected_gap, gJ_semantic_gap, interaction_order, r12_replay_id
}
lineage admitted_repository_freshness from repository_freshness_records
assert coupling.relation_order.preserved == true
assert schema.valid == true
emit json admitted_repository_freshness

        private BrowserTab FindTab(int id){int i;for(i=0;i<_tabs.Count;i++)if(_tabs[i].Id==id)return _tabs[i];return null;}
        private void SelectTab(int id)
        {
            BrowserTab t=FindTab(id);if(t==null)return;int i;for(i=0;i<_tabs.Count;i++){bool active=_tabs[i].Id==id;_tabs[i].Surface.Visibility=active?Visibility.Visible:Visibility.Collapsed;_tabs[i].Pill.Background=Brush(active?"#D9FFFFFF":"#62FFFFFF");_tabs[i].Pill.BorderBrush=Brush(active?"#647B9CB7":"#338CA4BC");}SyncChrome();
        }
        private void CloseTab(int id)
        {
            BrowserTab t=FindTab(id);if(t==null)return;bool was=t.Surface.Visibility==Visibility.Visible;_surface.Children.Remove(t.Surface);_tabRail.Children.Remove(t.Pill);_tabs.Remove(t);t.Generation++;
            if(_tabs.Count==0)Dispatch("new_tab","",0);else if(was)SelectTab(_tabs[Math.Max(0,_tabs.Count-1)].Id);else SyncChrome();
        }
        private void SyncChrome()
        {
            BrowserTab t=ActiveTab;if(t==null)return;_syncing=true;_address.Text=t.LogicalUrl=="vb://new-tab"?"":t.LogicalUrl;_syncing=false;OnAddressChanged(null,null);Title="VB JA21 DF_Medium Browser 8.0.3"+(t.Private?" · Private control":"");
        }
        private void Status(string text){_status.Text=text;}
        private void ShowAbout()
        {
            if(_drawer!=null){_drawer.OpenDrawer();_drawer.SetDetail("VB JA21 DF_Medium Browser 8.0.3\n\nWeb engine: DF_Medium / Bottle Rocket native VM derivative\nJA21 workload: HTML/CSS/resource/layout/scene semantics\nNative shell adapter: Windows WPF presenter only\nNetwork device primitive: bounded .NET/Windows HTTPS byte transport\nImage/media device primitives: WPF/WIC/Media Foundation presentation\n\nNo Chromium, Edge, WebView2, Electron, Node or MSHTML browser engine is loaded. Site JavaScript remains isolated in this release; server HTML/CSS, images and directly addressable media are handled through the DF_Medium JA21 engine/resource graph.");}
        }
        private void ToggleMaximize(){if(_immersive){ToggleImmersive();return;}WindowState=WindowState==WindowState.Maximized?WindowState.Normal:WindowState.Maximized;}
        private void ToggleImmersive()
        {
            if(!_immersive){_immersive=true;WindowState=WindowState.Normal;Left=0;Top=0;Width=SystemParameters.PrimaryScreenWidth;Height=SystemParameters.PrimaryScreenHeight;Topmost=true;Status("Immersive omni mode · F11 to return");}
            else{_immersive=false;Topmost=false;WindowState=WindowState.Maximized;Status("Omni window · maximized");}
            if(_drawer!=null){_drawer.Topmost=Topmost;if(_drawer.IsOpen)_drawer.Position(true);}
        }
        private void OnPreviewKeyDown(object sender,KeyEventArgs e)
        {
            if(e.Key==Key.F11){Dispatch("fullscreen","",0);e.Handled=true;return;} if(e.Key==Key.Escape&&_drawer!=null&&_drawer.IsOpen){_drawer.CloseDrawer();e.Handled=true;return;}
            if(Keyboard.Modifiers==ModifierKeys.Control&&e.Key==Key.L){Dispatch("focus_address","",0);e.Handled=true;return;} if(Keyboard.Modifiers==ModifierKeys.Control&&e.Key==Key.T){Dispatch("new_tab","",0);e.Handled=true;return;}
            if(Keyboard.Modifiers==ModifierKeys.Control&&e.Key==Key.W){Dispatch("close_active","",0);e.Handled=true;return;} if(Keyboard.Modifiers==ModifierKeys.Control&&e.Key==Key.R){Dispatch("refresh","",0);e.Handled=true;return;}
            if(Keyboard.Modifiers==(ModifierKeys.Control|ModifierKeys.Shift)&&e.Key==Key.N){Dispatch("private_tab","",0);e.Handled=true;return;} if(Keyboard.Modifiers==ModifierKeys.Alt&&e.Key==Key.Left){Dispatch("back","",0);e.Handled=true;return;} if(Keyboard.Modifiers==ModifierKeys.Alt&&e.Key==Key.Right){Dispatch("forward","",0);e.Handled=true;return;}
        }
    }

    public static class Program
    {
        [STAThread]
        public static void Run(string root)
        {
            RuntimeSeal.Verify(root);
            string source=File.ReadAllText(System.IO.Path.Combine(root,"source","browser.ja"),Encoding.UTF8); string sourceHash=RuntimeSeal.Sha256(Encoding.UTF8.GetBytes(source));
            JavaScriptSerializer js=new JavaScriptSerializer();js.MaxJsonLength=Int32.MaxValue;
            Dictionary<string,object> unit=(Dictionary<string,object>)js.DeserializeObject(File.ReadAllText(System.IO.Path.Combine(root,"engine","ja21","browser.ir.json"),Encoding.UTF8));
            if(!String.Equals(sourceHash,Convert.ToString(unit["sourceHash"]),StringComparison.OrdinalIgnoreCase))throw new Exception("JA21 source/IR identity mismatch.");
            Dictionary<string,object> corpus=(Dictionary<string,object>)js.DeserializeObject(File.ReadAllText(System.IO.Path.Combine(root,"engine","ja21","corpus.lock.json"),Encoding.UTF8)); if(Convert.ToInt32(corpus["suite_count"])!=20)throw new Exception("JA21 corpus lock is incomplete.");
            Dictionary<string,object> profile=(Dictionary<string,object>)js.DeserializeObject(File.ReadAllText(System.IO.Path.Combine(root,"engine","ja21","profile.json"),Encoding.UTF8)); if(Convert.ToBoolean(profile["electron"]))throw new Exception("JA21 profile unexpectedly enables Electron.");
            string rendererSource=File.ReadAllText(System.IO.Path.Combine(root,"source","renderer.ja"),Encoding.UTF8);string rendererSourceHash=RuntimeSeal.Sha256(Encoding.UTF8.GetBytes(rendererSource));Dictionary<string,object> rendererUnit=(Dictionary<string,object>)js.DeserializeObject(File.ReadAllText(System.IO.Path.Combine(root,"engine","ja21","renderer.ir.json"),Encoding.UTF8));if(!String.Equals(rendererSourceHash,Convert.ToString(rendererUnit["sourceHash"]),StringComparison.OrdinalIgnoreCase))throw new Exception("JA Mirror renderer source/IR identity mismatch.");
            string webSource=File.ReadAllText(System.IO.Path.Combine(root,"source","web_engine.ja"),Encoding.UTF8);string webHash=RuntimeSeal.Sha256(Encoding.UTF8.GetBytes(webSource));Dictionary<string,object> webUnit=(Dictionary<string,object>)js.DeserializeObject(File.ReadAllText(System.IO.Path.Combine(root,"engine","ja21","web_engine.ir.json"),Encoding.UTF8));if(!String.Equals(webHash,Convert.ToString(webUnit["sourceHash"]),StringComparison.OrdinalIgnoreCase))throw new Exception("DF_Medium JA21 web-engine source/IR identity mismatch.");
            DfMediumNative.Boot(root);
            DfSmallHelper helper=new DfSmallHelper(root);
            System.Windows.Application app=new System.Windows.Application();app.ShutdownMode=ShutdownMode.OnMainWindowClose;BrowserWindow window=new BrowserWindow(root,new Ja21Vm(unit),new Ja21Vm(rendererUnit),helper);app.Run(window);
        }
    }
}

        private void OnBrandMouseDown(object sender, MouseButtonEventArgs e)
        {
            if (e.ClickCount == 2) { Dispatch("maximize","",0); e.Handled = true; return; }
            if (e.LeftButton == MouseButtonState.Pressed && WindowState == WindowState.Normal && !_immersive) { try { DragMove(); } catch { } }
        }
        private void OnAddressKeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Enter) { e.Handled = true; Dispatch("navigate", _address.Text, 0); }
            else if (e.Key == Key.Escape) { SyncChrome(); Keyboard.ClearFocus(); }
        }
        private void OnAddressChanged(object sender, TextChangedEventArgs e)
        {
            if (_syncing) return;
            string raw = _address.Text;
            if (String.IsNullOrWhiteSpace(raw)) { _predict.Text = "Ask, search, or enter an address"; return; }
            try
            {
                string normalized = Convert.ToString(_vm.Run("normalize", raw));
                if (String.IsNullOrEmpty(normalized)) { _predict.Text = "Blocked by JA21 policy"; return; }
                if (normalized.StartsWith("https://html.duckduckgo.com/html/?q=", StringComparison.OrdinalIgnoreCase)) _predict.Text = "Search the web · Enter";
                else if (normalized == "vb://new-tab") _predict.Text = "Open a calm new workspace · Enter";
                else { Uri u; _predict.Text = Uri.TryCreate(normalized, UriKind.Absolute, out u) ? "Open " + u.Host + " · Enter" : "Open · Enter"; }
            }
            catch { _predict.Text = "Review input"; }
        }

        private BrowserTab ActiveTab
        {
            get { int i; for (i=0;i<_tabs.Count;i++) if (_tabs[i].Surface.Visibility==Visibility.Visible) return _tabs[i]; return null; }
        }
        private Dictionary<string, object> Model()
        {
            BrowserTab t=ActiveTab; Dictionary<string,object> m=new Dictionary<string,object>(StringComparer.Ordinal);
            m["active"]=t==null?0:t.Id; m["count"]=_tabs.Count; m["can_back"]=t!=null&&t.CanGoBack; m["can_forward"]=t!=null&&t.CanGoForward; m["loading"]=t!=null&&t.Loading; return m;
        }
        public void DispatchPublic(string kind, string input, int id) { Dispatch(kind,input,id); }
        private void Dispatch(string kind, string input, int id)
        {
            try
            {
                Dictionary<string,object> ev=new Dictionary<string,object>(StringComparer.Ordinal); ev["kind"]=kind; ev["id"]=id; ev["input"]=input==null?"":input;
                Dictionary<string,object> action=(Dictionary<string,object>)_vm.Run("on_event",Model(),ev); Execute(action);
            }
            catch(Exception ex){ Status("JA21 · "+ex.Message); }
        }
        private void Execute(Dictionary<string, object> a)
        {
            string kind=Convert.ToString(a["kind"]); int id=Convert.ToInt32(a["id"]); string value=Convert.ToString(a["value"]);
            if(kind=="create"){CreateTab(value,false);return;} if(kind=="create_private"){CreateTab(value,true);Status("Private control tab · history remains in memory for this process only.");return;}
            if(kind=="load"){BrowserTab t=FindTab(id);if(t!=null)Navigate(t,value);return;} if(kind=="select"){SelectTab(id);return;} if(kind=="close"){CloseTab(id);return;}
            BrowserTab active=ActiveTab;
            if(kind=="back"&&active!=null&&active.CanGoBack){active.HistoryIndex--;Navigate(active,active.History[active.HistoryIndex],false);return;} if(kind=="forward"&&active!=null&&active.CanGoForward){active.HistoryIndex++;Navigate(active,active.History[active.HistoryIndex],false);return;}
            if(kind=="reload"&&active!=null){Navigate(active,active.LogicalUrl,false);return;} if(kind=="stop"&&active!=null){active.Generation++;active.Loading=false;Status("Load stopped · current generation retired");SyncChrome();return;}
            if(kind=="downloads"){try{Process.Start("explorer.exe",Environment.GetFolderPath(Environment.SpecialFolder.UserProfile)+"\\Downloads");}catch(Exception ex){Status(ex.Message);}return;}
            if(kind=="clear_data"){Status("DF_Medium JA21 Web Engine keeps no persistent cookie/local-storage engine in this profile; there is no ambient site store to clear.");return;}
            if(kind=="about"){ShowAbout();return;} if(kind=="drawer_toggle"){if(_drawer!=null)_drawer.Toggle();return;} if(kind=="drawer_close"){if(_drawer!=null)_drawer.CloseDrawer();return;}
            if(kind=="helper_status"){if(_drawer!=null){_drawer.OpenDrawer();_drawer.SetDetail(_helper.Summary);}Status("Auxiliary DF_Small · "+_helper.Summary);return;}
            if(kind=="helper_verify"){RunHelper("verify");return;} if(kind=="helper_pulse"){RunHelper("pulse");return;}
            if(kind=="minimize"){WindowState=WindowState.Minimized;return;} if(kind=="maximize"){ToggleMaximize();return;} if(kind=="fullscreen"){ToggleImmersive();return;} if(kind=="close_window"){Close();return;}
            if(kind=="focus_address"){_address.Focus();_address.SelectAll();return;} if(kind=="status"){Status(value);return;}
        }
        private void RunHelper(string operation)
        {
            Status("Auxiliary DF_Small · running "+operation+"…"); if(_drawer!=null)_drawer.OpenDrawer();
            _helper.RunNativeAsync(operation,delegate(string text,bool ok){Dispatcher.BeginInvoke(new Action(delegate{if(_drawer!=null)_drawer.SetHelperResult(text,ok);Status(ok?"Auxiliary DF_Small · completed":"Auxiliary DF_Small · host toolchain or gate needs attention");}));});
        }

        private void CreateTab(string url, bool isPrivate)
        {
            BrowserTab t=new BrowserTab();t.Id=_nextId++;t.Private=isPrivate;t.LogicalUrl="vb://new-tab";t.Title=isPrivate?"Private":"New tab";
            Grid surface=new Grid();surface.Visibility=Visibility.Collapsed;surface.Background=Brush("#FFF9FBFD");t.Surface=surface;Grid pageHost=new Grid();t.PageHost=pageHost;surface.Children.Add(pageHost);_surface.Children.Add(surface);
            TextBlock label=Label(t.Title,11.5,FontWeights.Medium,"#3E5066",new Thickness(0));t.PillText=label;
            Button pill=GhostButton("",118);pill.Height=28;pill.Margin=new Thickness(3,0,3,0);pill.Background=Brush("#75FFFFFF");pill.BorderBrush=Brush("#338CA4BC");pill.Content=label;pill.Tag=t.Id;pill.Click+=delegate{Dispatch("select_tab","",t.Id);};pill.MouseRightButtonUp+=delegate{Dispatch("close_tab","",t.Id);};t.Pill=pill;_tabRail.Children.Add(pill);
            _tabs.Add(t);SelectTab(t.Id);Navigate(t,url,true);
        }
        private void UpdateTabTitle(BrowserTab t)
        {
            string title=String.IsNullOrWhiteSpace(t.Title)?(t.Private?"Private":"New tab"):t.Title;if(title.Length>24)title=title.Substring(0,23)+"…";t.PillText.Text=(t.Private?"◌ ":"")+title;
        }
        private void Navigate(BrowserTab t,string url){Navigate(t,url,true);}
        private void Navigate(BrowserTab t,string url,bool pushHistory)
        {
            if(t==null)return;if(String.IsNullOrEmpty(url)||url=="vb://new-tab"){ShowHome(t);if(pushHistory)PushHistory(t,"vb://new-tab");return;}if(url=="about:blank"){ShowBlank(t);if(pushHistory)PushHistory(t,"about:blank");return;}
            url=JaLinkTarget.Resolve(url);Uri u;if(!Uri.TryCreate(url,UriKind.Absolute,out u)){Status("Invalid address.");return;}string scheme=u.Scheme.ToLowerInvariant();bool allowed=false;try{allowed=(bool)_vm.Run("page_allowed",scheme,false);}catch{allowed=false;}if(!allowed||(scheme!="http"&&scheme!="https")){Status("Navigation blocked by JA21 policy.");return;}if(!String.IsNullOrEmpty(u.UserInfo)){Status("Credential-bearing URLs are blocked.");return;}
            int generation=++t.Generation;t.Loading=true;t.ShowingHome=false;t.LogicalUrl=u.AbsoluteUri;t.Title=u.Host;UpdateTabTitle(t);if(pushHistory)PushHistory(t,t.LogicalUrl);ShowLoading(t,u);SyncChrome();Status("DF_Medium Web Device fetch · "+u.Host);
            Task.Factory.StartNew(delegate
            {
                try
                {
                    JaMirrorNetworkClient net=new JaMirrorNetworkClient();JaMirrorFetchResult result=net.Fetch(u);
                    Dictionary<string,object> meta=new Dictionary<string,object>(StringComparer.Ordinal);meta["scheme"]=result.FinalUri.Scheme.ToLowerInvariant();meta["mime"]=MimeOnly(result.ContentType);meta["bytes"]=result.Bytes;meta["redirects"]=result.Redirects;if(!(bool)_rendererVm.Run("fetch_allowed",meta))throw new Exception("JA renderer policy rejected the fetched document budget.");Dictionary<string,object> docPolicy=(Dictionary<string,object>)_rendererVm.Run("document_policy",MimeOnly(result.ContentType));if(!Convert.ToBoolean(docPolicy["allow"]))throw new Exception(Convert.ToString(docPolicy["reason"]));
                    Dispatcher.BeginInvoke(new Action(delegate
                    {
                        if(generation!=t.Generation)return;try{DfMediumDocumentSurface renderer=new DfMediumDocumentSurface(delegate(string link){Navigate(t,JaLinkTarget.Resolve(link),true);});UIElement view=renderer.Build(result.Text,result.FinalUri);t.PageHost.Children.Clear();t.PageHost.Children.Add(view);t.Loading=false;t.LogicalUrl=result.FinalUri.AbsoluteUri;t.Title=renderer.Title;UpdateTabTitle(t);ReplaceCurrentHistory(t,t.LogicalUrl);SyncChrome();Status("DF_Medium JA21 ready · "+result.Bytes+" bytes · "+renderer.NodeCount+" nodes · "+renderer.ScriptCount+" scripts isolated · "+renderer.VmCalls+" VM device calls");}catch(Exception renderEx){t.Loading=false;ShowError(t,"Render",renderEx.Message);SyncChrome();}
                    }));
                }
                catch(Exception ex)
                {
                    Dispatcher.BeginInvoke(new Action(delegate{if(generation!=t.Generation)return;t.Loading=false;ShowError(t,"Fetch",ex.Message);SyncChrome();Status("JA Mirror · "+ex.Message);}));
                }
            });
        }
        private static string MimeOnly(string contentType){if(String.IsNullOrWhiteSpace(contentType))return "";int semi=contentType.IndexOf(';');return (semi<0?contentType:contentType.Substring(0,semi)).Trim().ToLowerInvariant();}
        private void PushHistory(BrowserTab t,string url){if(t.HistoryIndex>=0&&t.HistoryIndex<t.History.Count&&t.History[t.HistoryIndex]==url)return;if(t.HistoryIndex+1<t.History.Count)t.History.RemoveRange(t.HistoryIndex+1,t.History.Count-t.HistoryIndex-1);t.History.Add(url);t.HistoryIndex=t.History.Count-1;}
        private void ReplaceCurrentHistory(BrowserTab t,string url){if(t.HistoryIndex>=0&&t.HistoryIndex<t.History.Count)t.History[t.HistoryIndex]=url;}
        private void ShowLoading(BrowserTab t,Uri u)
        {
            t.PageHost.Children.Clear();Grid g=new Grid();g.Background=Brush("#FFF9FBFD");StackPanel s=new StackPanel();s.Width=540;s.HorizontalAlignment=HorizontalAlignment.Center;s.VerticalAlignment=VerticalAlignment.Center;g.Children.Add(s);Border orb=new Border();orb.Width=52;orb.Height=52;orb.CornerRadius=new CornerRadius(26);orb.Background=Brush("#BDE7F6FA");orb.BorderBrush=Brush("#598AA5B8");orb.BorderThickness=new Thickness(1);orb.HorizontalAlignment=HorizontalAlignment.Center;orb.Child=Label("JA",13,FontWeights.SemiBold,"#32556D",new Thickness(0));s.Children.Add(orb);TextBlock h=Label("Reconstituting document",22,FontWeights.SemiBold,"#25384C",new Thickness(0,18,0,6));h.HorizontalAlignment=HorizontalAlignment.Center;s.Children.Add(h);TextBlock p=Label(u.Host+" · DF_Medium JA21 web engine",12.5,FontWeights.Normal,"#718294",new Thickness(0));p.HorizontalAlignment=HorizontalAlignment.Center;s.Children.Add(p);t.PageHost.Children.Add(g);
        }
        private void ShowError(BrowserTab t,string stage,string message)
        {
            t.PageHost.Children.Clear();Grid g=new Grid();g.Background=Brush("#FFF9FBFD");Border card=new Border();card.MaxWidth=760;card.Padding=new Thickness(32);card.CornerRadius=new CornerRadius(24);card.BorderThickness=new Thickness(1);card.BorderBrush=Brush("#448EA6B8");card.Background=Brush("#EFFFFFFF");card.HorizontalAlignment=HorizontalAlignment.Center;card.VerticalAlignment=VerticalAlignment.Center;StackPanel s=new StackPanel();card.Child=s;s.Children.Add(Label("DF_MEDIUM · "+stage.ToUpperInvariant(),10.5,FontWeights.SemiBold,"#758698",new Thickness(0,0,0,8)));s.Children.Add(Label("The JA21 web workload could not be completed.",25,FontWeights.SemiBold,"#26394C",new Thickness(0,0,0,10)));TextBlock p=Label(message,13.5,FontWeights.Normal,"#687A8C",new Thickness(0));p.TextWrapping=TextWrapping.Wrap;s.Children.Add(p);g.Children.Add(card);t.PageHost.Children.Add(g);
        }
        private void ShowBlank(BrowserTab t){t.Generation++;t.LogicalUrl="about:blank";t.Loading=false;t.Title="Blank";t.PageHost.Children.Clear();t.PageHost.Background=Brush("#FFF9FBFD");UpdateTabTitle(t);SyncChrome();}
        private void ShowHome(BrowserTab t)
        {
            t.Generation++;t.LogicalUrl="vb://new-tab";t.Loading=false;t.ShowingHome=true;t.Title=t.Private?"Private":"New tab";UpdateTabTitle(t);t.PageHost.Children.Clear();
            Grid g=new Grid();g.Background=Brush("#00FFFFFF");Ellipse e1=new Ellipse();e1.Width=620;e1.Height=620;e1.Fill=new RadialGradientBrush(Color.FromArgb(105,170,238,245),Color.FromArgb(0,170,238,245));e1.HorizontalAlignment=HorizontalAlignment.Left;e1.VerticalAlignment=VerticalAlignment.Top;e1.Margin=new Thickness(-220,-260,0,0);g.Children.Add(e1);Ellipse e2=new Ellipse();e2.Width=720;e2.Height=720;e2.Fill=new RadialGradientBrush(Color.FromArgb(90,204,190,255),Color.FromArgb(0,204,190,255));e2.HorizontalAlignment=HorizontalAlignment.Right;e2.VerticalAlignment=VerticalAlignment.Bottom;e2.Margin=new Thickness(0,0,-280,-320);g.Children.Add(e2);
            Border card=new Border();card.Width=790;card.Padding=new Thickness(42,38,42,36);card.CornerRadius=new CornerRadius(30);card.BorderThickness=new Thickness(1);card.BorderBrush=Brush("#4C8EA6B8");card.Background=Brush("#E9FFFFFF");card.HorizontalAlignment=HorizontalAlignment.Center;card.VerticalAlignment=VerticalAlignment.Center;card.Effect=new DropShadowEffect{BlurRadius=45,ShadowDepth=9,Opacity=.075,Color=Colors.SlateGray};g.Children.Add(card);StackPanel s=new StackPanel();card.Child=s;
            s.Children.Add(Label("DF_MEDIUM · JA21 NATIVE WEB ENGINE",10.5,FontWeights.SemiBold,"#6E8193",new Thickness(0,0,0,9)));s.Children.Add(Label("A native JA21 web machine.",36,FontWeights.SemiBold,"#203346",new Thickness(0,0,0,13)));TextBlock copy=Label("Search or enter an address above. DF_Medium executes the JA21 web workload: document ingress, HTML interpretation, CSS cascade, resource discovery, layout and scene generation occur inside the Bottle Rocket VM-derived engine. Windows supplies only the omni window, TLS byte transport, pixels and media-device primitives.",14,FontWeights.Normal,"#64778A",new Thickness(0));copy.TextWrapping=TextWrapping.Wrap;copy.LineHeight=23;s.Children.Add(copy);Border line=new Border();line.Height=1;line.Background=Brush("#318EA6B8");line.Margin=new Thickness(0,24,0,18);s.Children.Add(line);WrapPanel pills=new WrapPanel();s.Children.Add(pills);string[] items=new string[]{"DF_Medium VM","JA21 web ABI","JA HTML/CSS","JA scene graph","image + video resources","scripts isolated"};for(int i=0;i<items.Length;i++){Border p=new Border();p.CornerRadius=new CornerRadius(999);p.BorderThickness=new Thickness(1);p.BorderBrush=Brush("#358EA6B8");p.Background=Brush("#7AFFFFFF");p.Padding=new Thickness(10,6,10,6);p.Margin=new Thickness(0,0,7,7);p.Child=Label(items[i],10.5,FontWeights.Medium,"#52677A",new Thickness(0));pills.Children.Add(p);}t.PageHost.Children.Add(g);SyncChrome();
